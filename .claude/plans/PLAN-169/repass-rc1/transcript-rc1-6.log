   165	def _audit_dir_from_env() -> Path:
   166	    """Resolve the audit dir, aligned with audit_emit._audit_dir().
   167	
   168	    Precedence mirrors audit_emit + spool_writer so the HMAC sidecars
   169	    (key, last-hmac, chain-length) co-locate with the audit log + its
   170	    FileLock under the coherent-env contract (processes writing one log
   171	    share the same CEO_AUDIT_LOG_DIR, or all run pure-$HOME):
   172	
   173	      ``CEO_AUDIT_LOG_PATH`` parent (the EFFECTIVE log — most specific,
   174	      rail r2 D) -> ``CEO_AUDIT_LOG_DIR`` -> ``CEO_PROJECT_STATE_DIR`` ->
   175	      the single family resolver (``_lib/runtime_paths``, PLAN-182 W1:
   176	      ``$HOME/.claude/projects/<native-slug>/``).
   177	
   178	    Honoring CEO_AUDIT_LOG_DIR closes a latent split (S168): a LOG_DIR-only
   179	    process resolved its FileLock under LOG_DIR but its chain-length counter
   180	    under $HOME, so two such processes (same $HOME, different LOG_DIR)
   181	    shared one counter while holding different locks — a lost counter
   182	    increment that weakens tail-truncation detection.
   183	    """
   184	    # PLAN-182 W1 rail r2 D: a familia segue o LOG EFETIVO — PATH (mais
   185	    # especifico) vence DIR, igual a audit_emit._log_path/_log_family_dir,
   186	    # spool_writer e audit_log. Com AMBOS setados, log+lock+key+sidecars
   187	    # ficam TODOS no parent do PATH; a ordem antiga (DIR primeiro) partia
   188	    # a familia em dois diretorios.
   189	    p = os.environ.get("CEO_AUDIT_LOG_PATH")
   190	    log_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   191	    if p:
   192	        path_parent = Path(p).resolve().parent
   193	        # rail r9 P1 — PRESERVACAO DE CADEIA EXISTENTE: numa instalacao
   194	        # que JA rodava com DIR e PATH divergentes, a chave/sidecars
   195	        # vivem sob DIR (a precedencia antiga). Trocar a precedencia sem
   196	        # olhar cunharia uma chave NOVA ao lado do log e NENHUMA das duas
   197	        # verificaria a cadeia inteira. Regra: se a chave legada existe
   198	        # sob DIR e ainda NAO existe no destino, a familia CONTINUA no
   199	        # DIR (breadcrumb nomeando a config); a migracao dos sidecars e
   200	        # decisao de cerimonia, nunca um efeito colateral de import.
   201	        if log_dir:
   202	            legacy_dir = Path(log_dir)
   203	            preserve = False
   204	            try:
   205	                if legacy_dir.resolve() != path_parent:
   206	                    # rail r10 P1a: QUALQUER sidecar legado conta, nao so a
   207	                    # audit-key com nome default — uma instalacao com
   208	                    # CEO_AUDIT_KEY_PATH explicito ainda tem last-hmac e
   209	                    # chain-length sob LOG_DIR, e ignora-los reiniciaria a
   210	                    # cadeia (genesis + contador zerado).
   211	                    legacy_marks = (
   212	                        legacy_dir / KEY_FILENAME,
   213	                        legacy_dir / LAST_HMAC_FILENAME,
   214	                        legacy_dir / CHAIN_LENGTH_FILENAME,
   215	                    )
   216	                    # rail r13 P1-3: uma `audit-key` no destino NAO
   217	                    # prova que a cadeia migrou — com CEO_AUDIT_KEY_PATH
   218	                    # explicito apontando para la, o last-hmac e o
   219	                    # chain-length continuam sob LOG_DIR e o append
   220	                    # seguinte leria genesis/zero. Só os SIDECARS DE
   221	                    # CADEIA contam como evidencia de migracao.
   222	                    dest_marks = (
   223	                        path_parent / LAST_HMAC_FILENAME,
   224	                        path_parent / CHAIN_LENGTH_FILENAME,
   225	                    )
   226	                    preserve = (any(m.exists() for m in legacy_marks)
   227	                                and not any(m.exists() for m in dest_marks))
   228	            except OSError:
   229	                preserve = False
   230	            if preserve:
   231	                # rail r10 P1b: a DECISAO ja esta tomada; o breadcrumb e
   232	                # best-effort e NUNCA pode derruba-la (stderr fechado /
   233	                # nao-gravavel / encoding hostil quebraria a preservacao
   234	                # da cadeia por causa de um diagnostico).
   235	                try:
   236	                    sys.stderr.write(
   237	                        "# audit_hmac: CEO_AUDIT_LOG_DIR e "
   238	                        "CEO_AUDIT_LOG_PATH divergem e sidecars legados "
   239	                        "vivem em %s — PRESERVADOS ali (migracao = "
   240	                        "cerimonia, PLAN-182 W1/W2)\n" % legacy_dir)
   241	                except Exception:
   242	                    pass
   243	                return legacy_dir
   244	        return path_parent
   245	    if log_dir:
   246	        return Path(log_dir)
   247	    state = os.environ.get("CEO_PROJECT_STATE_DIR")
   248	    if state:
   249	        return Path(state)
   250	    # PLAN-182 W1 (ADR-001 S318 amendment): default delegates to the
   251	    # single family resolver — per-project native slug, no literal.
   252	    return _runtime_paths.runtime_state_dir()
   253	
