   887	def _sha256_of_canonical_json(entry_clean: Dict[str, Any]) -> str:
   888	    """sha256 over the canonical_json bytes (deterministic idempotence marker).
   889	
   890	    entry_clean MUST exclude internal _drain_* metadata + hmac field. The
   891	    canonical_json encoder is the same one ADR-055 HMAC chain uses, so the
   892	    digest is reproducible across re-drains.
   893	    """
   894	    if _canonical_json is None:
   895	        raw = json.dumps(entry_clean, sort_keys=True, separators=(",", ":"),
   896	                         ensure_ascii=False).encode("utf-8")
   897	    else:
   898	        raw = _canonical_json.encode(entry_clean)
   899	    return hashlib.sha256(raw).hexdigest()
