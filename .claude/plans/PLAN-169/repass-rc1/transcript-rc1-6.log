   940	def _flush_journal_buffer(pid: int) -> None:
   941	    """Flush buffered journal envelopes for PID with a single fsync.
   942	
   943	    P1-2: invoked at drain boundary, signal handler, atexit, or when
   944	    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires
   945	    the per-PID journal flock around the append+fsync window.
   946	    """
   947	    buf = _JOURNAL_BUFFER.get(pid)
   948	    if not buf:
   949	        return
   950	    p = _journal_path(pid)
   951	    try:
   952	        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   953	    except OSError as e:
   954	        _breadcrumb(f"journal mkdir failed: {type(e).__name__}: {e}")
   955	        return
   956	    payload = b"".join(buf)
   957	    try:
   958	        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):
   959	            fd = os.open(
   960	                str(p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600,
   961	            )
   962	            try:
   963	                os.write(fd, payload)
   964	                os.fsync(fd)
   965	            finally:
   966	                os.close(fd)
   967	        # Only clear on successful write; on failure the buffer retains
   968	        # the envelopes for the next flush attempt (best-effort durability).
   969	        _JOURNAL_BUFFER[pid] = []
   970	    except FileLockTimeout:
   971	        _breadcrumb(f"journal flock timeout pid={pid}")
   972	    except OSError as e:
   973	        _breadcrumb(f"journal flush failed: {type(e).__name__}: {e}")
