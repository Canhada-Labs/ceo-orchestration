    80	def _read_existing(path: Path) -> Optional[bytes]:
    81	    """Read salt file if present and well-formed.
    82	
    83	    Returns the bytes if size matches ``_SALT_BYTES``; ``None`` if
    84	    the file is absent, the wrong size, or unreadable. Callers
    85	    treat ``None`` as "regenerate".
    86	    """
    87	    try:
    88	        if not path.exists():
    89	            return None
    90	        data = path.read_bytes()
    91	    except OSError:
    92	        return None
    93	    if len(data) != _SALT_BYTES:
    94	        return None
