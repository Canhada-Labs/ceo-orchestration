   522	def _recover_ordinal_counter(spool_path: Path) -> int:
   523	    """Return ordinal_within_file counter from existing spool body.
   524	
   525	    iter4-P1-1: replaces prior `\n`-counting approach. A complete body
   526	    line WITHOUT trailing `\n` (writer fsync'd then crashed before
   527	    terminator) was previously counted as zero entries → ordinal 0
   528	    re-issued → Phase 3 monotonicity quarantine. Now: parse each line
   529	    (terminated or not), return max(ordinal)+1. Returns 0 on missing/
   530	    empty/header-only/no-valid-ordinals.
   531	    """
   532	    try:
   533	        with open(str(spool_path), "rb") as f:
   534	            content = f.read()
   535	    except OSError:
   536	        return 0
   537	    if b"\n" not in content:
   538	        return 0
   539	    _header, body = content.split(b"\n", 1)
   540	    if not body:
   541	        return 0
   542	    max_ord = -1
   543	    for line_bytes in body.split(b"\n"):
   544	        if not line_bytes.strip():
   545	            continue
   546	        try:
   547	            entry = json.loads(line_bytes)
   548	        except (json.JSONDecodeError, ValueError):
   549	            continue
   550	        if not isinstance(entry, dict):
   551	            continue
   552	        o = entry.get("ordinal_within_file")
   553	        if isinstance(o, int) and o > max_ord:
   554	            max_ord = o
   555	    return max_ord + 1 if max_ord >= 0 else 0
