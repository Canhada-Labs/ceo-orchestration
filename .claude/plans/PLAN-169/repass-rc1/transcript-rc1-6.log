   408	def reset_cache_for_test() -> None:
   409	    """Test-only: clear the module-level salt cache.
   410	
   411	    Production code MUST NOT call this. The cache invariant —
   412	    salt is loaded at most once per process — is part of the
   413	    fail-open guarantee (filesystem failures after the first
   414	    successful load do not affect subsequent calls).
   415	    """
   416	    global _CACHED_SALT
   417	    _CACHED_SALT = None
   140	# Threat coverage:
   141	#   - stale audit_emit.py on sys.path → resolved_parent != canonical → CATCH
   142	#   - stale canonical_json.py on sys.path → CATCH
   143	#   - fully-stale `_lib/` tree (audit_hmac + audit_emit + canonical_json
   144	#     all in the SAME stale dir) → _CANONICAL_LIB_DIR resolves to the
   145	#     stale dir → FALSE-OK at this layer. Defense-in-depth: the
   146	#     WS-B conftest snapshot guard + the in-tree pytest regression
   147	#     (`.claude/hooks/tests/test_lib_canonical_import.py`) catch the
   148	#     fully-stale case at test-collection time.
   149	_CANONICAL_LIB_DIR = Path(__file__).resolve().parent
   150	
   151	
   152	# Process-level cache (single subprocess invocation lifetime).
   153	# The audit-key does not rotate mid-invocation so caching is safe.
   154	# PLAN-182 W1 rail r2 B1: keyed pelo key_path() resolvido — um processo
   155	# que troca de projeto (CLAUDE_PROJECT_DIR/cwd) NUNCA assina o projeto B
   156	# com a chave do A. Tupla (path_str, key_bytes); miss em path novo.
   157	_KEY_CACHE: Optional[Tuple[str, bytes]] = None
   158	
