   229	def get_instance_salt() -> bytes:
   230	    """Return the per-installation salt; generate + persist on first call.
   231	
   232	    Caches the salt in module memory after first successful read or
   233	    generation. Subsequent calls return the cached bytes without
   234	    touching the filesystem.
   235	
   236	    Returns ``b""`` on persistent I/O failure; callers must compose
   237	    the result with their input ``hashlib.sha256(salt + payload)``
   238	    such that an empty salt degrades to the unsalted hash.
   239	    """
   240	    global _CACHED_SALT
   241	    path = _salt_path()
   242	    # rail r6: identidade ABSOLUTA (override relativo + chdir nao pode
   243	    # servir o salt do projeto anterior).
   244	    path_id = os.path.abspath(str(path))
   245	    cached = _CACHED_SALT
   246	    if cached is not None and cached[0] == path_id:
   247	        return cached[1]
   248	
   249	    existing = _read_existing(path)
   250	    if existing is not None:
   251	        _CACHED_SALT = (path_id, existing)
   252	        return existing
   253	
   254	    # rail r15 P2-4: distinguir CRIACAO de RECUPERACAO. Um `.salt`
   255	    # existente porem malformado (tamanho errado) faz `_read_existing`
   256	    # devolver None e cair aqui — registrar isso como `first_mint`
   257	    # esconderia uma ROTACAO real (que invalida a correlacao de
   258	    # prompt_sha256) e sobrescreveria o marcador anterior.
   259	    #
   260	    # rc.1 re-pass part 6 C2 — that distinction used to be drawn by a
   261	    # `path.exists()` probe right here, and the probe cannot draw it: it
   262	    # cannot tell "was already there, malformed" from "appeared one
   263	    # microsecond ago because another process just won the mint". A loser
   264	    # that read the file as absent and then found it present concluded
   265	    # ROTATION and truncated the winner — which is the very defect this
   266	    # cure exists to close, re-introduced by the classifier. The first
   267	    # cut of this cure did exactly that, and its own concurrency test
   268	    # caught it.
   269	    #
   270	    # So the classification moves AFTER the exclusive create, which is the
   271	    # only race-free moment available: O_EXCL succeeding IS "first mint",
   272	    # and O_EXCL failing hands us a file we can then read and judge.
   273	    _rotation = False
   274	    salt, _outcome = _generate_and_persist(path)
   275	    if _outcome == "exists":
   276	        _winner = _read_existing(path)
   277	        if _winner is not None:
   278	            # We lost the race. The winner's bytes are on disk, so they are
   279	            # what every future reader reproduces `prompt_sha256` from — we
   280	            # adopt them and register NO mint, because we minted nothing and
   281	            # a marker here would be forensic ground truth for an event that
   282	            # never happened.
   283	            _CACHED_SALT = (path_id, _winner)
   284	            return _winner
