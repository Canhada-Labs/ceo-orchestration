   488	def _validate_spool_header_strict(header: Any) -> bool:
   489	    """Strict 4-field header invariant — same predicate used by Phase 2
   490	    quarantine and `_ensure_spool_header` PID-reuse path.
   491	
   492	    iter5-P1 closure: factored out so writer-side reuse cannot accept a
   493	    header that the drainer will later reject. Mismatch between writer
   494	    and drainer validation = silent data loss for events appended after
   495	    the lax reuse but before Phase 2 quarantine.
   496	
   497	    Returns True only when ALL of:
   498	      - dict with `_spool_header: True`
   499	      - `_spool_uuid: str` of length 16 and matching `^[0-9a-f]{16}$`
   500	      - `_pid: int`
   501	      - `_created_wall_ns: int`
   502	      - `_created_monotonic_ns: int`
   503	    """
   504	    if not isinstance(header, dict):
   505	        return False
   506	    if header.get("_spool_header") is not True:
   507	        return False
   508	    spool_uuid = header.get("_spool_uuid")
   509	    if (not isinstance(spool_uuid, str)
   510	            or len(spool_uuid) != _SPOOL_UUID_HEX_LEN
   511	            or _SPOOL_UUID_RE.match(spool_uuid) is None):
   512	        return False
   513	    if not isinstance(header.get("_pid"), int):
   514	        return False
   515	    if not isinstance(header.get("_created_wall_ns"), int):
   516	        return False
   517	    if not isinstance(header.get("_created_monotonic_ns"), int):
   518	        return False
   519	    return True
