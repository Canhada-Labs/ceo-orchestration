   124	def get_instance_salt() -> bytes:
   125	    """Return the per-installation salt; generate + persist on first call.
   126	
   127	    Caches the salt in module memory after first successful read or
   128	    generation. Subsequent calls return the cached bytes without
   129	    touching the filesystem.
   130	
   131	    Returns ``b""`` on persistent I/O failure; callers must compose
   132	    the result with their input ``hashlib.sha256(salt + payload)``
   133	    such that an empty salt degrades to the unsalted hash.
   134	    """
   135	    global _CACHED_SALT
   136	    if _CACHED_SALT is not None:
   137	        return _CACHED_SALT
   138	
   139	    path = _salt_path()
   140	    existing = _read_existing(path)
