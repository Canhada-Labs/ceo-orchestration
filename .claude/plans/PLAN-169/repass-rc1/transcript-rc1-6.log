   815	    header = {
   816	        "_spool_header": True,
   817	        "_spool_uuid": secrets.token_hex(8),
   818	        "_pid": pid,
   819	        "_created_wall_ns": time.time_ns(),
   820	        "_created_monotonic_ns": time.monotonic_ns(),
