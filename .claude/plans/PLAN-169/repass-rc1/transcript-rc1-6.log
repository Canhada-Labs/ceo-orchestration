  9275	            "." + marker.name + "." + str(os.getpid()) + "." + _rand + ".tmp"
  9276	        )
  9277	        _flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
  9278	        _flags |= getattr(os, "O_NOFOLLOW", 0)  # POSIX; 0 is a safe no-op
  9279	        _fd = os.open(str(tmp), _flags, 0o600)
