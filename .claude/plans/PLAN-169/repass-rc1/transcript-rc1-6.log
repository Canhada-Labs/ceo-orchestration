   265	def _state_dir() -> Path:
   266	    """Return <audit_dir>/state/ ensuring parents exist (0700).
   267	
   268	    P1-5: state dir is unconditionally a child of audit_emit._audit_dir();
   269	    no CEO_PROJECT_STATE_DIR override (audit_emit doesn't expose one).
   270	
   271	    PLAN-111 Wave A: single-slot cache keyed on (CEO_AUDIT_LOG_DIR, HOME).
   272	    Cache HIT skips mkdir syscall + Path construction (saves ~17us/call x
   273	    5.7x/emit cumulative ~= 100us/emit recovery).
   274	
   275	    Cache MISS semantics (AC-A2a + SA-K10 permission re-assertion +
   276	    PLAN-113 W4-SEC mode-mismatch self-heal):
   277	      1. Resolve target Path (uses _project_dir_from_env cache implicitly).
   278	      2. Attempt mkdir(parents=True, exist_ok=True, mode=0o700).
   279	      3. If mkdir FAILS: breadcrumb + DO NOT cache (next call retries).
   280	      4. If mkdir SUCCEEDS: validate via lstat() that dir is not a symlink,
   281	         is owned by os.getuid(), and has mode 0o700.
   282	         - symlink / wrong-owner mismatch: FAIL-CLOSED (raise) — we never
   283	           chmod-and-trust an attacker-controlled or other-owned dir.
   284	         - mode-only mismatch (e.g. a pre-existing state/ at 0o755 created
   285	           by an older path; exist_ok=True does NOT relax perms): attempt
   286	           SELF-HEAL via os.chmod(d, 0o700) then RE-lstat + re-validate the
   287	           full invariant. If it is now a non-symlink, owned by os.getuid(),
   288	           AND 0o700 → PROCEED (cache + return). Otherwise keep the SA-K10
   289	           fail-CLOSED.
   290	      5. Only if validation (incl. any self-heal) succeeds: cache the Path.
   291	
   292	    Single-threaded contract: concurrent os.environ mutation = UB.
   293	    """
   294	    global _STATE_DIR_CACHE
   295	    # PLAN-182 W1: key covers ALL resolver inputs (see
   296	    # _project_dir_cache_key) — a mid-process project switch must not be
   297	    # served the previous project's state dir.
   298	    env_key = _project_dir_cache_key()
