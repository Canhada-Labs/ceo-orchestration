   154	def _audit_dir_from_env() -> Path:
   155	    """Resolve the audit dir, aligned with audit_emit._audit_dir().
   156	
   157	    Precedence mirrors audit_emit + spool_writer so the HMAC sidecars
   158	    (key, last-hmac, chain-length) co-locate with the audit log + its
   159	    FileLock under the coherent-env contract (processes writing one log
   160	    share the same CEO_AUDIT_LOG_DIR, or all run pure-$HOME):
   161	
   162	      ``CEO_AUDIT_LOG_DIR`` (primary — matches audit_emit._audit_dir) ->
   163	      ``CEO_AUDIT_LOG_PATH`` parent -> ``CEO_PROJECT_STATE_DIR`` ->
   164	      ``$HOME/.claude/projects/ceo-orchestration/``.
   165	
   166	    Honoring CEO_AUDIT_LOG_DIR closes a latent split (S168): a LOG_DIR-only
   167	    process resolved its FileLock under LOG_DIR but its chain-length counter
   168	    under $HOME, so two such processes (same $HOME, different LOG_DIR)
   169	    shared one counter while holding different locks — a lost counter
   170	    increment that weakens tail-truncation detection.
   171	    """
   172	    log_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   173	    if log_dir:
   174	        return Path(log_dir)
   175	    p = os.environ.get("CEO_AUDIT_LOG_PATH")
   176	    if p:
   177	        return Path(p).resolve().parent
   178	    state = os.environ.get("CEO_PROJECT_STATE_DIR")
   179	    if state:
   180	        return Path(state)
   181	    home = os.environ.get("HOME") or str(Path.home())
   182	    return Path(home) / ".claude" / "projects" / "ceo-orchestration"
