    61	def _slug_dir() -> Path:
    62	    """Return the per-installation state directory.
    63	
    64	    Mirrors ``audit_emit._audit_dir`` so the salt sits next to the
    65	    audit log it protects. Avoids importing ``audit_emit`` to keep
    66	    this module loadable from any hook (including hooks that emit
    67	    no audit events).
    68	    """
    69	    home = os.environ.get("HOME") or str(Path.home())
    70	    return Path(home) / ".claude" / "projects" / "ceo-orchestration"
    71	
    72	
    73	def _salt_path() -> Path:
    74	    return _slug_dir() / _SALT_FILENAME
