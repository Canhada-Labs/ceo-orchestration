   115	        try:
   116	            return Path(env_path).resolve().parent
   117	        except OSError:
   118	            pass
   119	    env_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   120	    if env_dir:
   121	        return Path(env_dir)
   122	    return _runtime_paths.runtime_state_dir()
