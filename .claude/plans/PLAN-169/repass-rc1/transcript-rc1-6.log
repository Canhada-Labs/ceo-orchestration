   286	        # it ONCE — never a retry loop, since a second EEXIST would mean a
   287	        # third writer we would simply lose to again. A well-formed salt
   288	        # landing between the read above and this replace would be
   289	        # overwritten; that window is a few instructions wide and only
   290	        # opens when the file was already corrupt, which is strictly
   291	        # narrower than the pre-cure behaviour of always truncating.
   292	        _rotation = True
   293	        salt, _outcome = _generate_and_persist(path, replace_existing=True)
   294	    if _outcome == "created" and salt:
   295	        _CACHED_SALT = (path_id, salt)
   296	        _register_mint(path, reason="other" if _rotation else "first_mint")
   297	    return salt
