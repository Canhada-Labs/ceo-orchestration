   300	def _register_mint(salt_path: Path, reason: str = "first_mint") -> None:
   301	    """Make the mint OBSERVABLE (ADR-079 S318 amendment §2). Fail-open.
   302	
   303	    (a) Marker sidecar next to the salt — forensic ground truth that
   304	        survives even when no emitter ever runs in this project.
   305	    (b) Best-effort lazy chain event ``salt_rotation_registered``
   306	        (kwargs top-level; the SLUG travels only as a 16-hex sha256
   307	        prefix, and the salt path text is never sent).
   308	
   309	    rc.1 re-pass part 6 C5 — this used to say "the path text never
   310	    reaches the wire" without qualification, which reads as a claim
   311	    about the whole event and is false: ``project`` is a REQUIRED base
   312	    field of every registered line (SPEC/v1/audit-log.schema.md) and
   313	    carries the repository path here exactly as it does on every other
   314	    event, in this version and in v1.3.0. What this arm keeps off the
   315	    wire is the SLUG text and the salt's own path, not the repository
   316	    identifier the schema requires.
   317	
   318	    Neither arm may raise: salt availability is invariant (ADR-005).
   319	    """
   320	    slug = ""
   321	    try:
   322	        slug = _runtime_paths.project_slug()
   323	    except Exception:
   324	        pass
   325	    slug_sha16 = (
   326	        hashlib.sha256(slug.encode("utf-8")).hexdigest()[:16] if slug else ""
   327	    )
   328	    try:
   329	        marker = {
   330	            "minted_at_epoch": int(time.time()),
   331	            "reason": reason,
   332	            "salt_scope": "project",
   333	            "slug_sha256": slug_sha16,
   334	            "pid": os.getpid(),
   335	        }
   336	        marker_path = salt_path.parent / _MINT_MARKER_FILENAME
   337	        # rc.1 re-pass part 6 C3 — `write_text` FOLLOWS a symlink and
   338	        # truncates its target, and the `chmod` that used to follow it
   339	        # dropped that target to 0600. The re-pass reproduced both against
   340	        # a file outside the state tree. Planting the link needs write
   341	        # access to a 0700 directory, so this is same-UID hardening rather
   342	        # than a modelled threat (docs/threat-model.md) — but the write
   343	        # side of this library already refuses to follow links (PLAN-024),
   344	        # and one writer in the family behaving differently is the
   345	        # inconsistency, not the risk calculation.
   346	        if os.path.islink(str(marker_path)):
   347	            # Named refusal, fail-open like the rest of this arm: the salt
   348	            # is minted and usable; only the forensic sidecar is skipped.
   349	            _breadcrumb_target = str(marker_path)
