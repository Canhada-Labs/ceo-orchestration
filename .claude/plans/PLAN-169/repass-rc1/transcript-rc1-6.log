   567	def _quarantine_corrupt_active_spool(spool_path: Path, pid: int) -> bool:
   568	    """Rename malformed-header active spool aside; forensic emit.
   569	
   570	    iter4-P1-2: caller MUST hold `_spool_flock_path(pid)`. We must NOT
   571	    call drain_now() here (Phase 2 re-acquires this same flock →
   572	    self-timeout). _forensic() has its own re-entry guard so the emit
   573	    path won't recurse into spool_append.
   574	
   575	    iter6-P1: returns True on successful rename, False on rename failure.
   576	    Caller MUST honor False by aborting the current append fail-open
   577	    (NOT minting a fresh header over the still-present corrupt file —
   578	    that would let new events land behind a header Phase 2 will quarantine).
   579	    """
   580	    epoch = secrets.token_hex(4)
   581	    corrupt_path = spool_path.with_name(
   582	        f"{spool_path.stem}.corrupt-header.{epoch}"
   583	    )
   584	    try:
   585	        os.rename(str(spool_path), str(corrupt_path))
   586	    except OSError as e:
   587	        _breadcrumb(
   588	            f"quarantine_corrupt_active_spool rename failed pid={pid}: "
   589	            f"{type(e).__name__}: {e}"
   590	        )
   591	        return False
   592	    _forensic("audit_spool_tamper_detected", {
   593	        "mismatch_kind": "malformed_active_spool_header",
   594	        "spool_pid": pid,
   595	        "corrupt_path": str(corrupt_path),
   596	        "drain_epoch": epoch,
   597	    })
   598	    return True
