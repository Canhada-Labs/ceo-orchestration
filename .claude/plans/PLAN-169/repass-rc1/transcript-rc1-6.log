   229	def get_instance_salt() -> bytes:
   230	    """Return the per-installation salt; generate + persist on first call.
   231	
   232	    Caches the salt in module memory after first successful read or
   233	    generation. Subsequent calls return the cached bytes without
   234	    touching the filesystem.
   235	
   236	    Returns ``b""`` on persistent I/O failure; callers must compose
   237	    the result with their input ``hashlib.sha256(salt + payload)``
   238	    such that an empty salt degrades to the unsalted hash.
   239	    """
   240	    global _CACHED_SALT
   241	    path = _salt_path()
   242	    # rail r6: identidade ABSOLUTA (override relativo + chdir nao pode
   243	    # servir o salt do projeto anterior).
   244	    path_id = os.path.abspath(str(path))
   245	    cached = _CACHED_SALT
   246	    if cached is not None and cached[0] == path_id:
   247	        return cached[1]
   248	
   249	    existing = _read_existing(path)
   250	    if existing is not None:
   251	        _CACHED_SALT = (path_id, existing)
   252	        return existing
   253	
   254	    # rail r15 P2-4: distinguir CRIACAO de RECUPERACAO. Um `.salt`
   255	    # existente porem malformado (tamanho errado) faz `_read_existing`
   256	    # devolver None e cair aqui — registrar isso como `first_mint`
   257	    # esconderia uma ROTACAO real (que invalida a correlacao de
   258	    # prompt_sha256) e sobrescreveria o marcador anterior.
   259	    #
   260	    # rc.1 re-pass part 6 C2 — that distinction used to be drawn by a
   261	    # `path.exists()` probe right here, and the probe cannot draw it: it
   262	    # cannot tell "was already there, malformed" from "appeared one
   263	    # microsecond ago because another process just won the mint". A loser
   264	    # that read the file as absent and then found it present concluded
   265	    # ROTATION and truncated the winner — which is the very defect this
   266	    # cure exists to close, re-introduced by the classifier. The first
   267	    # cut of this cure did exactly that, and its own concurrency test
   268	    # caught it.
   269	    #
   270	    # So the classification moves AFTER the exclusive create, which is the
   271	    # only race-free moment available: O_EXCL succeeding IS "first mint",
   272	    # and O_EXCL failing hands us a file we can then read and judge.
   273	    _rotation = False
   274	    salt, _outcome = _generate_and_persist(path)
   275	    if _outcome == "exists":
   276	        _winner = _read_existing(path)
   277	        if _winner is not None:
   278	            # We lost the race. The winner's bytes are on disk, so they are
   279	            # what every future reader reproduces `prompt_sha256` from — we
   280	            # adopt them and register NO mint, because we minted nothing and
   281	            # a marker here would be forensic ground truth for an event that
   282	            # never happened.
   283	            _CACHED_SALT = (path_id, _winner)
   284	            return _winner
   285	        # Present but malformed: the rotation case (rail r15 P2-4). Replace
   286	        # it ONCE — never a retry loop, since a second EEXIST would mean a
   287	        # third writer we would simply lose to again. A well-formed salt
   288	        # landing between the read above and this replace would be
   289	        # overwritten; that window is a few instructions wide and only
   290	        # opens when the file was already corrupt, which is strictly
   291	        # narrower than the pre-cure behaviour of always truncating.
   292	        _rotation = True
   293	        salt, _outcome = _generate_and_persist(path, replace_existing=True)
   294	    if _outcome == "created" and salt:
   295	        _CACHED_SALT = (path_id, salt)
   296	        _register_mint(path, reason="other" if _rotation else "first_mint")
   297	    return salt
   298	
   299	
   300	def _register_mint(salt_path: Path, reason: str = "first_mint") -> None:
   301	    """Make the mint OBSERVABLE (ADR-079 S318 amendment §2). Fail-open.
   302	
   303	    (a) Marker sidecar next to the salt — forensic ground truth that
   304	        survives even when no emitter ever runs in this project.
   305	    (b) Best-effort lazy chain event ``salt_rotation_registered``
   306	        (kwargs top-level; the SLUG travels only as a 16-hex sha256
   307	        prefix, and the salt path text is never sent).
   308	
   309	    rc.1 re-pass part 6 C5 — this used to say "the path text never
   310	    reaches the wire" without qualification, which reads as a claim
   311	    about the whole event and is false: ``project`` is a REQUIRED base
   312	    field of every registered line (SPEC/v1/audit-log.schema.md) and
   313	    carries the repository path here exactly as it does on every other
   314	    event, in this version and in v1.3.0. What this arm keeps off the
   315	    wire is the SLUG text and the salt's own path, not the repository
   316	    identifier the schema requires.
   317	
   318	    Neither arm may raise: salt availability is invariant (ADR-005).
   319	    """
   320	    slug = ""
   321	    try:
   322	        slug = _runtime_paths.project_slug()
   323	    except Exception:
   324	        pass
   325	    slug_sha16 = (
   326	        hashlib.sha256(slug.encode("utf-8")).hexdigest()[:16] if slug else ""
   327	    )
   328	    try:
   329	        marker = {
   330	            "minted_at_epoch": int(time.time()),
   331	            "reason": reason,
   332	            "salt_scope": "project",
   333	            "slug_sha256": slug_sha16,
   334	            "pid": os.getpid(),
   335	        }
   336	        marker_path = salt_path.parent / _MINT_MARKER_FILENAME
   337	        # rc.1 re-pass part 6 C3 — `write_text` FOLLOWS a symlink and
   338	        # truncates its target, and the `chmod` that used to follow it
   339	        # dropped that target to 0600. The re-pass reproduced both against
   340	        # a file outside the state tree. Planting the link needs write
   341	        # access to a 0700 directory, so this is same-UID hardening rather
   342	        # than a modelled threat (docs/threat-model.md) — but the write
   343	        # side of this library already refuses to follow links (PLAN-024),
   344	        # and one writer in the family behaving differently is the
   345	        # inconsistency, not the risk calculation.
   346	        if os.path.islink(str(marker_path)):
   347	            # Named refusal, fail-open like the rest of this arm: the salt
   348	            # is minted and usable; only the forensic sidecar is skipped.
   349	            _breadcrumb_target = str(marker_path)
   350	            raise OSError(
   351	                "mint marker path is a symlink, refusing to follow: %s"
   352	                % _breadcrumb_target
   353	            )
   354	        _tmp_path = marker_path.parent / (
   355	            "." + _MINT_MARKER_FILENAME + "." + os.urandom(6).hex() + ".tmp"
   356	        )
   357	        _mfd = os.open(
   358	            str(_tmp_path),
   359	            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
   360	            _SALT_MODE,
   361	        )
   362	        try:
   363	            with os.fdopen(_mfd, "w", encoding="utf-8") as _mfh:
   364	                _mfh.write(json.dumps(marker, sort_keys=True) + "\n")
   365	            try:
   366	                os.chmod(str(_tmp_path), _SALT_MODE)
   367	            except OSError:
   368	                pass
   369	            # `os.replace` renames ONTO the destination: it does not follow
   370	            # a symlink there, it replaces it. The islink check above is
   371	            # what makes the refusal explicit rather than incidental.
   372	            os.replace(str(_tmp_path), str(marker_path))
   373	        except Exception:
   374	            try:
   375	                os.unlink(str(_tmp_path))
   376	            except OSError:
   377	                pass
   378	            raise
   379	    except Exception:
   380	        pass
   381	    try:
   382	        # Lazy, one-shot, mint-time only: no module-load coupling on the
   383	        # emit stack for the 99.999% of calls that never mint.
   384	        try:  # package member first, bare fallback (mirrors header import)
   385	            from . import audit_emit as _audit_emit  # type: ignore
   386	        except ImportError:
   387	            import audit_emit as _audit_emit  # type: ignore
   388	        # rail r13 P1-4: `session_id` e `project` sao campos REQUERIDOS
   389	        # da linha registrada no SPEC v2.58 e `_write_event` nao os
   390	        # sintetiza — sem eles o evento de migracao nasce sem atribuicao.
   391	        _sid = os.environ.get("CLAUDE_SESSION_ID") or ""
   392	        try:
   393	            _proj = str(_runtime_paths.project_dir())
   394	        except Exception:
   395	            _proj = ""
   396	        _audit_emit.emit_generic(
   397	            "salt_rotation_registered",
   398	            session_id=_sid,
   399	            project=_proj,
   400	            reason=reason,
   401	            salt_scope="project",
   402	            slug_sha256=slug_sha16 or "invalid",
   403	        )
   404	    except Exception:
   405	        pass
