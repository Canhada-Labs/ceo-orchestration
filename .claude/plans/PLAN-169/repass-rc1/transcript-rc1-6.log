  9027	def _context_pressure_marker_name(session_id: Any) -> str:
  9028	    """Marker basename for ``session_id`` (PLAN-179 rail finding A).
  9029	
  9030	    Returns the bare project-wide basename when ``session_id`` is absent /
  9031	    blank / not a string — the documented degraded mode, in which two
  9032	    concurrent sessions in one repo can interfere with each other's
  9033	    hysteresis. Otherwise returns ``<basename>.<sanitized-id>``.
  9034	
  9035	    Never raises: this runs inside a fail-open bookkeeping helper.
  9036	    """
  9037	    if not isinstance(session_id, str):
  9038	        return _CONTEXT_PRESSURE_STATE_BASENAME
  9039	    raw = session_id.strip()
  9040	    if not raw:
  9041	        return _CONTEXT_PRESSURE_STATE_BASENAME
  9042	    if (len(raw) <= _CONTEXT_PRESSURE_SID_MAX_LEN
  9043	            and all(ch in _CONTEXT_PRESSURE_SID_SAFE_CHARS for ch in raw)):
  9044	        suffix = raw
  9045	    else:
  9046	        # Local import: this module keeps hashlib out of its top-level import
  9047	        # surface and imports it at the point of use (see _short_hash et al).
  9048	        import hashlib
  9049	        suffix = hashlib.sha256(
  9050	            raw.encode("utf-8", errors="replace")
  9051	        ).hexdigest()[:32]
  9052	    return _CONTEXT_PRESSURE_STATE_BASENAME + "." + suffix
