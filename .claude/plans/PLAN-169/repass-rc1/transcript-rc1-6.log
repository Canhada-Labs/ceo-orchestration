   380	            if mismatch_reason is not None:
   381	                # PLAN-111 Wave A SA-K10 fail-CLOSED (Codex R2 P0 fix):
   382	                # detecting + not-caching is fake-security; caller would
   383	                # still write to the attacker-controlled symlink target.
   384	                # Raise OSError so callers' fail-open path catches it
   385	                # (matches existing _state_dir fail-open semantics) and
   386	                # diverts the write to fallback path. PLAN-113 W4-SEC: we
   387	                # only reach here for symlink / wrong-owner, OR a mode
   388	                # mismatch the chmod self-heal could not resolve.
   389	                _breadcrumb(
   390	                    f"_state_dir SECURITY mismatch (FAIL-CLOSED): "
   391	                    f"{mismatch_reason}"
   392	                )
