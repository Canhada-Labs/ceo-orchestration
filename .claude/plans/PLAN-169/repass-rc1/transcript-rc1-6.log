  2329	def drain_now(*, force: bool = False) -> DrainStats:
  2330	    """Execute 5-phase atomic drain. Bounded ≤K_MAX entries per call.
  2331	
  2332	    Fail-open invariant — any error sets stats.ok=False and is captured in
  2333	    stats.error. NEVER raises to caller.
  2334	    """
  2335	    stats = DrainStats()
  2336	    if is_sync_mode() and not force:
  2337	        return stats
  2338	    try:
  2339	        if not force and not should_drain():
  2340	            return stats
  2341	
  2342	        drain_epoch = secrets.token_hex(4)
  2343	        stats.drain_epoch = drain_epoch
  2344	        state_dir = _state_dir()
  2345	        our_pid = os.getpid()
  2346	        log_path = _canonical_log_path()
  2347	        log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
  2348	        lock_path = _canonical_log_lock()
  2349	
  2350	        # P1-2: flush any buffered journal envelopes BEFORE drain begins so
  2351	        # the journal reflects all begin/commit events up to this point
  2352	        # (op:"drained" envelopes are appended after canonical append).
  2353	        _flush_journal_buffer(our_pid)
  2354	
  2355	        # Phase 1 — canonical lock (deadlock-free; writers hold only their
  2356	        # own per-PID flocks, never the canonical lock).
  2357	        #
  2358	        # (ADR-055-AMEND-3) — opportunistic/forced split. A FORCED
  2359	        # drain (recovery / exit-handler / session-start) must complete, so it
  2360	        # blocks up to SPOOL_LOCK_TIMEOUT and a timeout there is anomalous. An
  2361	        # OPPORTUNISTIC drain (force=False, the per-emit hot path) is
  2362	        # best-effort: the lock holder plus the loser's own later drain cover
  2363	        # its events, so it acquires NON-BLOCKING (timeout=0 — a clean one-shot
  2364	        # try-lock, one flock(LOCK_NB) with no sleep) and yields silently on
  2365	        # contention instead of blocking the hook subprocess for 2.5s.
  2366	        canonical_timeout = SPOOL_LOCK_TIMEOUT if force else 0.0
