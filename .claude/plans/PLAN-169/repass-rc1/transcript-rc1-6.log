  2368	            with FileLock(lock_path, timeout=canonical_timeout):
  2369	                files, in_recovery = _phase2_sweep_and_rename(
  2370	                    state_dir, drain_epoch, our_pid,
  2371	                )
  2372	                stats.in_recovery_mode = in_recovery
  2373	
  2374	                valid_files: List[_DrainingFile] = []
  2375	                for f in files:
  2376	                    if _phase2_validate_header(f, drain_epoch):
