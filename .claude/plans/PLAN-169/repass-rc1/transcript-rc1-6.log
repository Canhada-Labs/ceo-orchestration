   869	        if last == b"\n":
   870	            return
   871	        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)
   872	        try:
   873	            os.write(fd, b"\n")
   874	            os.fsync(fd)
   875	        finally:
   876	            os.close(fd)
