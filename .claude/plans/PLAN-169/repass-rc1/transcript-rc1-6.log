   203	
   204	def _project_dir_from_env() -> Path:
   205	    """Return the audit project dir (BYTE-IDENTICAL to audit_emit._audit_dir).
   206	
   207	    P1-5: must mirror audit_emit._audit_dir() exactly — CEO_AUDIT_LOG_DIR
   208	    precedence, then the SAME single resolver (_lib/runtime_paths,
   209	    PLAN-182 W1) audit_emit delegates to. CEO_AUDIT_LOG_PATH is the FILE
   210	    path, not the dir path, so we do NOT derive the dir from it
   211	    (audit_emit doesn't either).
   212	
   213	    PLAN-111 Wave A cache, PLAN-182 W1 key: single-slot, keyed on
   214	    _project_dir_cache_key() (all resolver inputs). Cache HIT skips
   215	    re-construction of Path object. Cache MISS replaces the slot
   216	    atomically.
   217	
   218	    Single-threaded contract: concurrent os.environ mutation = UB.
   219	    """
   220	    global _PROJECT_DIR_CACHE
   221	    env_key = _project_dir_cache_key()
   222	    cached = _PROJECT_DIR_CACHE
   223	    if cached is not None and cached[0] == env_key:
   224	        return cached[1]
   225	    env_dir = env_key[0]
   226	    if env_dir:
   227	        p = Path(env_dir)
   228	    else:
   229	        p = _runtime_paths.runtime_state_dir()
   230	    _PROJECT_DIR_CACHE = (env_key, p)
   231	    return p
