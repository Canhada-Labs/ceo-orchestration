   394	                    f"_state_dir permission re-assertion failed: "
   395	                    f"{mismatch_reason}"
   396	                )
   397	            _STATE_DIR_CACHE = (env_key, d)
   398	        except PermissionError:
   399	            # Re-raise the SA-K10 fail-CLOSED so caller handles.
   400	            raise
   401	        except OSError as e:
   402	            _breadcrumb(f"_state_dir lstat failed (no cache): "
   403	                        f"{type(e).__name__}: {e}")
   404	    return d
