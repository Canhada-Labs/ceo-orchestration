  9206	def should_emit_context_pressure(
  9207	    used_bucket: Any, state_dir: Any, session_id: Any = None
  9208	) -> bool:
  9209	    """Return True only on a bucket TRANSITION (PLAN-179 W0 US2 / 8.1).
  9210	
  9211	    ``state_dir`` is the directory holding the marker — callers pass
  9212	    ``<project>/.claude/state``. The marker records the last percent bucket
  9213	    observed; a repeat of the same bucket returns False, a transition in
  9214	    EITHER direction returns True and re-arms the marker. This is
  9215	    hysteresis, not sampling: without it the rail emits one row per prompt
  9216	    while the session sits in a single rung, which is exactly the flood the
  9217	    HMAC chain must not carry.
  9218	
  9219	    ``session_id`` (PLAN-179 rail finding A, round-1 REJECT) KEYS that
  9220	    marker. It must be the TRUSTED id — the one the harness put in the hook
  9221	    input (``scratchpad_lib.session_id_from_event``), never
  9222	    ``CLAUDE_SESSION_ID`` from the environment, which any agent with a
  9223	    subshell can set (consensus M2). Passing None is legal and means the
  9224	    DEGRADED project-wide marker: hysteresis then behaves as it did before
  9225	    this fix, i.e. two concurrent sessions in the same repo suppress and
  9226	    re-arm each other and the wire rows cannot be attributed. Callers that
  9227	    have a trusted id must pass it; callers that do not should say so on the
  9228	    wire by omitting ``session_id`` from the event rather than inventing one.
  9229	
  9230	    FAIL-OPEN on infrastructure (house rule): any state I/O error — absent
  9231	    directory, unwritable path, corrupt or truncated marker — means
  9232	    "emit", and the caller is never allowed to see an exception. The caller
  9233	    is a hook; a bookkeeping file may not block or crash a user session.
  9234	    Fail-open costs at most a duplicate breadcrumb, whereas fail-closed
  9235	    would silently lose the very signal PLAN-179 exists to measure.
  9236	    """
  9237	    if not _context_pressure_bucket_ok(used_bucket):
  9238	        # Off-enum input must never re-arm the marker (that would let a
  9239	        # bogus value suppress the NEXT real transition). The dispatch
  9240	        # branch coerces the field itself, so there is nothing to debounce.
  9241	        return True
  9242	    try:
  9243	        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)
  9244	    except (TypeError, ValueError):  # pragma: no cover - defensive
  9245	        return True
  9246	    current = str(int(used_bucket))
  9247	    previous = None  # type: Optional[str]
  9248	    try:
  9249	        previous = marker.read_text(encoding="utf-8").strip()
  9250	    except (OSError, ValueError, UnicodeDecodeError):
  9251	        previous = None
  9252	    if previous == current:
  9253	        return False
  9254	    # Re-arm atomically (tmp + os.replace, 0600) — same idiom as
  9255	    # check_directory_added._atomic_write, kept inline so audit_emit gains
  9256	    # no new import.
  9257	    try:
  9258	        marker.parent.mkdir(parents=True, exist_ok=True)
  9259	        # PLAN-179 rail finding A: the tmp name is derived from the SAME
  9260	        # per-session marker name. Reusing the bare basename here would give
  9261	        # two sessions re-arming at the same moment one shared tmp path.
  9262	        # PLAN-179 rail round-3 [P1] — SYMLINK-SAFE, and the name is not
  9263	        # guessable. `.claude/state/` is gitignored and world-writable to
  9264	        # anything running as this user, so a PREDICTABLE tmp path could be
  9265	        # pre-created as a symlink; a plain `open(..., "w")` follows it and the
  9266	        # hook then truncates whatever it points at — an arbitrary-write
  9267	        # primitive that routes around every canonical-edit guard, reached
  9268	        # through an advisory audit helper. Three things close it together:
  9269	        # O_EXCL (refuses an existing path), O_NOFOLLOW (refuses a symlink even
  9270	        # if it appears between the check and the open), and a random suffix so
  9271	        # pre-creation is not feasible in the first place. The mode is set AT
  9272	        # CREATION, which also removes the window the old separate `chmod` left.
  9273	        _rand = os.urandom(6).hex()
  9274	        tmp = marker.parent / (
  9275	            "." + marker.name + "." + str(os.getpid()) + "." + _rand + ".tmp"
  9276	        )
  9277	        _flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
  9278	        _flags |= getattr(os, "O_NOFOLLOW", 0)  # POSIX; 0 is a safe no-op
  9279	        _fd = os.open(str(tmp), _flags, 0o600)
  9280	        try:
  9281	            with os.fdopen(_fd, "w", encoding="utf-8") as fh:
  9282	                fh.write(current + "\n")
  9283	        except Exception:
  9284	            # Never leave the temp behind on a failed write — the GC below
  9285	            # only sweeps by AGE, so an orphan would linger for a full TTL.
  9286	            try:
  9287	                os.unlink(str(tmp))
  9288	            except OSError:
  9289	                pass
  9290	            raise
  9291	        os.replace(str(tmp), str(marker))
  9292	    except (OSError, ValueError):
  9293	        _breadcrumb(
  9294	            "should_emit_context_pressure: marker re-arm failed — "
  9295	            "fail-open (the same bucket may emit twice)"
  9296	        )
  9297	    # PLAN-179 rail finding A: reclaim runs ONLY on the re-arm path, i.e. on a
  9298	    # rung TRANSITION, which is rare by construction (that is the whole point
  9299	    # of the hysteresis above). It is bounded and fail-open by its own
  9300	    # contract, and its result cannot change what this function returns.
  9301	    _gc_context_pressure_markers(marker.parent)
  9302	    return True
