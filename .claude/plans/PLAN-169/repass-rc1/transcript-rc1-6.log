   849	def _ensure_spool_ready_for_append(pid: int) -> None:
   850	    """iter3-P1-1: isolate any unterminated final line before appending.
   851	
   852	    If a prior writer died mid-write leaving no trailing newline, the next
   853	    append concatenates onto the partial line and the new event is lost.
   854	    Append a separator newline under the held spool flock to isolate the
   855	    partial fragment (Phase 3 will discard it). No-op when missing/empty/
   856	    already-newline-terminated. Caller MUST hold _spool_flock_path(pid).
   857	    Fail-open: breadcrumb on any OSError.
   858	    """
   859	    spool_p = _spool_path(pid)
   860	    try:
   861	        if not spool_p.exists():
   862	            return
   863	        st = spool_p.stat()
   864	        if st.st_size == 0:
   865	            return
   866	        with open(str(spool_p), "rb") as f:
   867	            f.seek(-1, os.SEEK_END)
   868	            last = f.read(1)
   869	        if last == b"\n":
   870	            return
   871	        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)
   872	        try:
   873	            os.write(fd, b"\n")
   874	            os.fsync(fd)
   875	        finally:
   876	            os.close(fd)
