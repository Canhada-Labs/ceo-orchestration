   136	def _validate_store_name(store_name: str) -> None:
   137	    """Reject store names that could escape the state root."""
   138	    if not store_name:
   139	        raise StateStoreInvalidName("store_name must be non-empty")
   140	    if len(store_name) > _STORE_NAME_MAX_LEN:
   141	        raise StateStoreInvalidName(
   142	            f"store_name too long ({len(store_name)} > {_STORE_NAME_MAX_LEN})"
   143	        )
   144	    # Allow kebab-case + underscore slugs only
   145	    for ch in store_name:
   146	        if not (ch.isalnum() or ch in "-_"):
   147	            raise StateStoreInvalidName(
   148	                f"store_name contains illegal char {ch!r}; allowed: [A-Za-z0-9_-]"
   149	            )
   150	
   151	
   152	def _validate_plan_id(plan_id: str) -> None:
   153	    """Reject plan_ids that could escape the store dir."""
   154	    if not plan_id:
   155	        raise StateStoreInvalidName("plan_id must be non-empty")
   156	    if len(plan_id) > _PLAN_ID_MAX_LEN:
   157	        raise StateStoreInvalidName(
   158	            f"plan_id too long ({len(plan_id)} > {_PLAN_ID_MAX_LEN})"
   159	        )
   160	    for ch in plan_id:
   161	        if not (ch.isalnum() or ch in "-_."):
   162	            raise StateStoreInvalidName(
   163	                f"plan_id contains illegal char {ch!r}; allowed: [A-Za-z0-9_.-]"
   164	            )
   165	    if plan_id.startswith(".") or ".." in plan_id:
   166	        raise StateStoreInvalidName(f"plan_id {plan_id!r} attempts path escape")
   167	
   168	
   169	def _plan_id_hash(plan_id: str) -> str:
   170	    """Short, stable hash for plan_id — used in audit events without leaking the raw id."""
   171	    return hashlib.sha256(plan_id.encode("utf-8", errors="replace")).hexdigest()[:16]
   172	
   173	
   174	def _key_hash(key: str) -> str:
   175	    """Short, stable hash for key — audit-safe."""
   176	    return hashlib.sha256(key.encode("utf-8", errors="replace")).hexdigest()[:16]
   177	
   178	
   179	class SqliteStateStore:
   180	    """Plan-scoped key/value store backed by a single sqlite file.
   181	
   182	    Not thread-safe within a process (callers should open one store per
   183	    thread). Cross-process safety is provided by the sibling filelock.
   184	
   185	    Args:
   186	        store_name: short slug identifying the store (e.g. "scratchpad").
   187	        plan_id: canonical PLAN-NNN string scoping the data.
   188	        value_max_bytes: per-key cap. Default 64 KiB.
   189	        lock_timeout: filelock wallclock budget. Default 5.0s.
   190	
   191	    Raises:
   192	        StateStoreInvalidName: if store_name or plan_id fail validation.
   193	    """
   194	
   195	    def __init__(
   196	        self,
   197	        store_name: str,
   198	        plan_id: str,
   199	        value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   200	        lock_timeout: float = _LOCK_TIMEOUT_SEC,
   201	        *,
   202	        clock: Optional[Callable[[], float]] = None,
   203	    ) -> None:
   204	        _validate_store_name(store_name)
   205	        _validate_plan_id(plan_id)
   206	        self.store_name = store_name
   207	        self.plan_id = plan_id
   208	        self.value_max_bytes = int(value_max_bytes)
   209	        self.lock_timeout = float(lock_timeout)
   210	        # PLAN-045 Wave 2 F-03-04: injectable clock so TTL tests can
   211	        # fast-forward instead of sleeping. Default: wall clock.
   212	        self._clock: Callable[[], float] = clock if clock is not None else time.time
   213	
   214	        self._store_dir = _state_root() / store_name
   215	        self._db_path = self._store_dir / f"{plan_id}.sqlite"
   216	        self._lock_path = self._store_dir / f"{plan_id}.sqlite.lock"
   217	
   218	        self._conn: Optional[sqlite3.Connection] = None
   219	        self._opened = False
   220	        self._db_ident = None  # (st_dev, st_ino) of the open db — round-11 [P2]
   221	
   222	    def _ensure_open(self) -> None:
   223	        if self._opened:
   224	            return
   225	        self._store_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
   226	        # sqlite connect will create the file if absent
   227	        self._conn = sqlite3.connect(
   228	            str(self._db_path),
   229	            timeout=self.lock_timeout,
   230	            isolation_level=None,  # autocommit; we manage transactions via BEGIN/COMMIT
   231	        )
   232	        # Tight file perms — owner-only
   233	        try:
   234	            os.chmod(self._db_path, 0o600)
   235	        except OSError:
   236	            pass
   237	        self._conn.execute("PRAGMA journal_mode=WAL")
   238	        self._conn.execute("PRAGMA synchronous=NORMAL")
   239	        self._conn.execute("PRAGMA temp_store=MEMORY")
   240	        self._conn.execute(
   241	            """
   242	            CREATE TABLE IF NOT EXISTS kv (
   243	                key TEXT PRIMARY KEY,
   244	                value BLOB NOT NULL,
   245	                expires_at INTEGER,           -- epoch seconds, NULL = no expiry
   246	                created_at INTEGER NOT NULL,  -- epoch seconds
   247	                redacted INTEGER NOT NULL     -- 1 if redact_secrets changed the value
   248	            )
   249	            """
   250	        )
   251	        self._conn.execute("CREATE INDEX IF NOT EXISTS idx_kv_expires ON kv(expires_at)")
   252	        # Identity of the inode this connection targets (rail round-11 [P2]):
   253	        # `_reopen_if_vanished` compares against it UNDER the lock to detect
   254	        # both absence and REPLACEMENT of the db file by another handle.
   255	        try:
   256	            _st = os.stat(self._db_path)
   257	            self._db_ident = (_st.st_dev, _st.st_ino)
   258	        except OSError:
   259	            self._db_ident = None
   260	        self._opened = True
   261	
   262	    # --- context manager --------------------------------------------------
   263	
   264	    def _reopen_if_vanished(self) -> None:
   265	        """GC coordination — MUST be called UNDER the FileLock.
   266	
   267	        PLAN-179 rail round-10 [P1]: the continuity GC unlinks aged session
   268	        stores while holding this same lock, and `_ensure_open` runs BEFORE
   269	        lock acquisition — so a connection opened earlier (or cached across
   270	        operations) can point at an UNLINKED inode; committing there loses
   271	        the write invisibly. Under the lock the check is race-free: if the
   272	        db identity is unchanged now, the GC cannot remove it until we
   273	        release; otherwise reopening lands the write on disk.
   274	
   275	        Rail round-11 [P2]: absence alone is NOT the whole signal. With two
   276	        handles opened before a GC unlink, the first reopen RECREATES the
   277	        path, so the second handle would see it existing while its own
   278	        connection still targets the dead inode. The identity compared is
   279	        therefore ``(st_dev, st_ino)`` captured at open time, which detects
   280	        REPLACEMENT as well as absence."""
   281	        if not self._opened:
   282	            return
   283	        try:
   284	            st = os.stat(self._db_path)
   285	            current = (st.st_dev, st.st_ino)
   286	        except OSError:
   287	            current = None
   288	        if current is not None and current == self._db_ident:
   289	            return
   290	        try:
   291	            if self._conn is not None:
   292	                self._conn.close()
   293	        except Exception:
   294	            pass
   295	        self._conn = None
   296	        self._opened = False
   297	        self._ensure_open()
   298	
   299	    def __enter__(self) -> "SqliteStateStore":
   300	        self._ensure_open()
     1	"""PLAN-119 WS-A — durable suite-wide audit-dir isolation REDIRECT.
     2	
     3	## Why this exists
     4	
     5	This repo **dogfoods an audit-emitting framework in its own repo against the
     6	real ``~/.claude``**. ``TestEnvContext`` (``_lib/testing.py``) isolates the
     7	audit dir *per test*, but that isolation is **opt-in**: any process that runs a
     8	hook / emits an audit event WITHOUT entering ``TestEnvContext`` writes to the
     9	LIVE ``~/.claude/projects/ceo-orchestration/audit-log.jsonl``. Those events
    10	carry HMACs computed under test conditions (or a different chain head), so
    11	``audit-verify-chain`` later reads ``tamper`` and ``audit-log.errors`` floods.
    12	S181 forensics: ~1690 of 1738 live-log lines were test/probe pollution.
    13	
    14	## What this does (Axis 1 — destination redirect)
    15	
    16	A **session-scoped autouse** fixture redirects the FULL audit/HMAC env carrier
    17	set (Codex R1 P0-3 — NOT just the four log vars) to a per-session tmpdir
    18	*before any test body runs*. A redirected process **physically cannot** append
    19	to the live log. This closes ~100 % of the pytest volume (the bulk of S181
    20	pollution) and carries **no suppression surface**: redirecting your own test's
    21	destination cannot silence someone else's real session (that was WS-B, dropped).
    22	
    23	A **function-scoped autouse** fixture additionally asserts (defense-in-depth)
    24	that the *production* audit-dir resolver (``audit_emit._audit_dir`` — imported,
    25	never re-implemented, per AC-A5) does not resolve to the snapshotted live dir,
    26	catching a test that mutates env back to the live dir mid-run.
    27	
    28	## Registration
    29	
    30	All three pytest conftests import the two fixtures by name so every collected
    31	test is covered regardless of which subtree pytest is invoked against:
    32	
    33	  - ``<repo>/conftest.py``                    (tree-wide — all ``testpaths``)
    34	  - ``.claude/hooks/tests/conftest.py``
    35	  - ``.claude/scripts/tests/conftest.py``     (net-new in PLAN-119 WS-A)
    36	
    37	The redirect is **idempotent** via a module-global guard: the first session
    38	fixture to run performs the real redirect and records the restore snapshot;
    39	later registrations (a sibling conftest's same-named fixture) detect the active
    40	redirect and become a no-op, so the three registrations never stack tmpdirs nor
    41	double-restore. Under ``pytest-xdist`` each worker is a separate process with
    42	its own module global → its own session tmpdir (plan R4).
    43	
    44	## Reuse by WS-C
    45	
    46	``audit_carrier_overrides()`` is the SINGLE source of the carrier-set
    47	enumeration; ``TestEnvContext.subprocess_env`` (WS-C) imports it so a spawned
    48	child inherits the exact same isolated destination — no second hand-maintained
    49	list to drift.
    50	
    51	## Escape hatch
    52	
    53	``@pytest.mark.allow_live_audit_dir`` (registered in ``pytest.ini``) marks the
    54	rare test that genuinely exercises the real resolver; the function-scope assert
    55	skips for it. Zero uses at ship; a ``validate-governance.sh`` grep gate keeps it
    56	at zero and CODEOWNERS requires security-engineer review to add one.
    57	
    58	## Axis 2 — whole-directory overrides (PLAN-182 W1 follow-up)
    59	
    60	PLAN-182 W1 gave the family a single resolver
    61	(``_lib/runtime_paths.runtime_state_dir()``) whose HIGHEST-precedence input is
    62	``CLAUDE_PROJECT_DIR_NATIVE`` — above the ``HOME`` Axis 1 redirects. An ambient
    63	value therefore steers runtime state OUT of the isolated tree no matter what
    64	Axis 1 does. Measured before this cure: a child ``pytest`` run whose only test
    65	body is ``assert True`` left ``audit-log.lock`` (0 bytes, 0600) and ``state/``
    66	(0700) in the operator's directory.
    67	
    68	Two properties of that escape decide the shape of the cure, and both were
    69	measured rather than assumed:
    70	
    71	1. **The write happens at interpreter shutdown**, not at import and not in the
    72	   test body. Probe: with the carrier set, ``from _lib import audit_emit``
    73	   listed the directory as empty BEFORE the import, empty AFTER the import, and
    74	   holding both entries after the process exited.
    75	2. **Any restore inside the process re-opens it.** A/B on a standalone child
    76	   run — clear-then-restore in a session-fixture finalizer left both entries in
    77	   the canary; clear-and-never-restore left it empty.
    78	
    79	So the carrier is CLEARED (never redirected) at MODULE IMPORT time and is
    80	DELIBERATELY absent from the restore snapshot. Clearing rather than redirecting
    81	also keeps the DEFAULT arm of ``runtime_state_dir()`` (``HOME`` + slug, which
    82	Axis 1 already isolates) reachable for the whole suite; pinning the top of the
    83	precedence chain to a session path would make that arm unreachable and would
    84	force a matching edit into ``audit_carrier_overrides`` and
    85	``TestEnvContext.subprocess_env``. Production code keeps the override in full:
    86	nothing here touches ``_lib/runtime_paths``, and a test that exercises the
    87	override sets it for its own duration with ``mock.patch.dict``.
    88	## Axis 3 — the COLLECTION window (S326, 2026-08-24)
    89	
    90	pytest runs NO fixture under ``--collect-only`` — and in a normal run every
    91	test module is IMPORTED before the session fixture body executes. Import-time
    92	code that reaches an audit emitter therefore ran with the carriers still
    93	pointing at the live tree, and Axis 2 had already popped the whole-dir
    94	override, so nothing could redirect it. Measured: ``test_policy_mutations``
    95	replayed the policy corpus at import → 124 HMAC-signed, unattributable events
    96	per ``pytest --collect-only``; ``verify-counts.sh`` runs one before every
    97	commit → 19 runs / 2,356 links in 12 h = 79% of the live segment.
    98	
    99	Cure (``_redirect_collection_window``, import-time like Axis 2): snapshot the
   100	live log path FIRST (the WS-D1 comparator must still know what "live" means),
   101	then point the primary anchor ``CEO_AUDIT_LOG_DIR`` + ``CEO_PROJECT_STATE_DIR``
   102	at a throwaway ``ceo-collect-isolation-*`` tree. The session fixture keeps
   103	re-pointing everything at its own tree; at session END its restore now hands
   104	back the COLLECTION tree instead of the live value, which also closes the
   105	teardown-window escape (a late emit after the restore used to reach the live
   106	log). ``HOME`` is deliberately NOT touched here — it steers user-site package
   107	resolution for subprocesses, and the session fixture owns that dance. Guard:
   108	``.claude/hooks/tests/test_collect_only_audit_isolation.py``.
   109	"""
   110	
   111	from __future__ import annotations
   112	
   113	import atexit
   114	import os
   115	import shutil
   116	import tempfile
   117	from pathlib import Path
   118	from typing import Dict, List, Optional
   119	
   120	import pytest
   121	
   122	# --- Carrier-set enumeration (Codex R1 P0-3) -----------------------------------
   123	# Every env var that can steer WHERE an emit / HMAC sidecar / spool / lock /
   124	# fallback resolves. Path-valued carriers are pointed under the session tmpdir;
   125	# the rotate-bytes carrier is CLEARED so a stale-inherited value cannot influence
   126	# rotation. The enumeration lives HERE, exactly once. WS-C imports it.
   127	
   128	# Directory-level anchors we SET to the isolated tree. ``CEO_AUDIT_LOG_DIR`` is
   129	# the PRIMARY resolver for every audit path — ``audit_emit._audit_dir`` /
   130	# ``audit_hmac._audit_dir_from_env`` / ``spool_writer._state_dir`` all honor it
   131	# FIRST. ``HOME`` is the *fallback* the resolvers reach when ``CEO_AUDIT_LOG_DIR``
   132	# is absent. We redirect BOTH (plus ``CEO_PROJECT_STATE_DIR``) and CLEAR the
   133	# per-file overrides, so the entire audit/HMAC/spool surface resolves to the
   134	# isolated tree EVEN IF a test pops ``CEO_AUDIT_LOG_DIR`` mid-run (the fallback
   135	# then hits the redirected HOME's ``.claude/`` — still non-live). This is the
   136	# airtight structural guarantee (Codex pair-rail P0): a kernel resolver guard
   137	# would be the alternative, but ``audit_emit``/``audit_hmac`` are kernel-HARD-DENY.
   138	#
   139	# Redirecting HOME does break subprocesses that resolve TOOLING via the real
   140	# home (PyYAML in the macOS user-site). ``_activate_redirect`` therefore PRESERVES
   141	# ``PYTHONUSERBASE`` (real user-site) AFTER the HOME redirect. ``GNUPGHOME`` is
   142	# the OPPOSITE — it is CLEARED (not preserved), so gpg resolves under the
   143	# redirected HOME's empty ``.gnupg`` and the suite cannot reach the real signing
   144	# keyring (a real-keyring leak let sentinel ``.asc`` verification SUCCEED in
   145	# tests that require it to fail; see TOOLING_CLEAR_VARS). Net: isolate the audit
   146	# dir + the GPG keyring, without breaking user-site package resolution.
   147	#
   148	# ``CLAUDE_PROJECT_DIR`` is DELIBERATELY NOT redirected — it steers where hooks
   149	# find the PROJECT's ``.claude/`` files (policies, team.md, cookbook patterns),
   150	# is not an audit-location carrier, and redirecting it broke "the real repo is
   151	# configured" tests (test_flip_closures, test_cookbook_advisor_hook) for zero
   152	# isolation gain.
   153	AUDIT_DIR_CARRIERS = (
   154	    "HOME",
   155	    "CEO_AUDIT_LOG_DIR",
   156	    "CEO_PROJECT_STATE_DIR",
   157	)
   158	# Tooling env vars re-exported (to REAL values) after the HOME redirect so a
   159	# subprocess can still resolve user-site packages (PyYAML etc.).
   160	TOOLING_PRESERVE_VARS = ("PYTHONUSERBASE",)
   161	# Tooling env vars CLEARED after the HOME redirect so they resolve under the
   162	# redirected (isolated) HOME. GNUPGHOME → the redirected HOME's empty `.gnupg`,
   163	# so the suite cannot use the real signing keyring (tests that exercise GPG set
   164	# their own keyring_home/GNUPGHOME).
   165	TOOLING_CLEAR_VARS = ("GNUPGHOME",)
   166	# Carriers we explicitly CLEAR (the "or-clear" half of set-or-clear). These are
   167	# the per-file path OVERRIDES + tunables. We do NOT set them to fixed session
   168	# paths because ``TestEnvContext`` re-isolates per test by re-pointing only
   169	# ``CEO_AUDIT_LOG_DIR`` (+ LOG_PATH/ERR/LOCK) and RELIES on the KEY /
   170	# LAST_HMAC / CHAIN_LENGTH sidecars defaulting off ``CEO_AUDIT_LOG_DIR``. If the
   171	# session redirect pinned those overrides to a session path, every
   172	# ``TestEnvContext`` test's sidecars would stay stuck in the session dir while
   173	# its log moved to the per-test dir → chain-length/canary mismatch. Clearing
   174	# them (a) removes any stale parent-shell value that could point at the live
   175	# tree and (b) lets both the session anchor and each per-test anchor drive
   176	# resolution coherently.
   177	AUDIT_CLEAR_CARRIERS = (
   178	    "CEO_AUDIT_LOG_PATH",
   179	    "CEO_AUDIT_LOG_ERR",
   180	    "CEO_AUDIT_LOG_LOCK",
   181	    "CEO_AUDIT_KEY_PATH",
   182	    "CEO_AUDIT_LAST_HMAC_PATH",
   183	    "CEO_AUDIT_CHAIN_LENGTH_PATH",
   184	    "CEO_AUDIT_LOG_FALLBACK_PATH",
   185	    "CEO_AUDIT_LOG_ROTATE_BYTES",
   186	    "CEO_AUDIT_HMAC_DISABLE",
