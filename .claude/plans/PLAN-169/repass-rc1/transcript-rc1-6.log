  1307	                    "file_age_hours": int(file_age_hours),
  1308	                    "stale_ttl_days": STALE_SPOOL_TTL_DAYS,
  1309	                    "drain_epoch": drain_epoch,
  1310	                    "prior_drain_epoch": old_epoch,
