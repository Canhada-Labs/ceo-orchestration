   382	        # Lazy, one-shot, mint-time only: no module-load coupling on the
   383	        # emit stack for the 99.999% of calls that never mint.
   384	        try:  # package member first, bare fallback (mirrors header import)
   385	            from . import audit_emit as _audit_emit  # type: ignore
   386	        except ImportError:
   387	            import audit_emit as _audit_emit  # type: ignore
   388	        # rail r13 P1-4: `session_id` e `project` sao campos REQUERIDOS
   389	        # da linha registrada no SPEC v2.58 e `_write_event` nao os
   390	        # sintetiza — sem eles o evento de migracao nasce sem atribuicao.
   391	        _sid = os.environ.get("CLAUDE_SESSION_ID") or ""
