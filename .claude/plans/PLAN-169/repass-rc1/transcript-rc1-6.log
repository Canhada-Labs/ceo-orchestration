   714	def _origin_for_new_spool() -> str:
   715	    """PLAN-119 WS-D1 — write-time origin stamp for a freshly-minted spool header.
   716	
   717	    Returns ``"test"`` when a test signal is present AT WRITE TIME
   718	    (``CEO_TEST_HARNESS=1`` or ``PYTEST_CURRENT_TEST`` set), else ``"live"``.
   719	    The writer knows the truth; the drainer cannot infer it later, so the stamp
   720	    is minted ONCE per spool (header) and is sticky to that PID's file. A real
   721	    session writes ``"live"`` and is never quarantined; legacy spool with no
   722	    ``_origin`` defaults to ``"live"`` at drain time (fail-safe toward never
   723	    dropping a real event).
   724	    """
   725	    if (os.environ.get("CEO_TEST_HARNESS") == "1"
   726	            or os.environ.get("PYTEST_CURRENT_TEST")):
   727	        return "test"
   728	    return "live"
   729	
   730	
   731	def _ensure_spool_header(pid: int, _retry_depth: int = 0) -> Dict[str, Any]:
   732	    """Return the header dict for the current spool, creating it if absent.
   733	
   734	    Header is written exactly once per spool file (first line). Fresh
   735	    _spool_uuid minted on creation so body[i].spool_uuid sentinel matches.
   736	
   737	    iter2-P1-4: existing nonempty spool with empty header cache (PID reuse,
   738	    module reload, pytest reset) → parse existing header + reuse uuid;
   739	    minting a new one would produce header_body_uuid_mismatch quarantine.
   740	    iter4-P1-1: ordinal recovery via body-line parse (max(ordinal)+1), NOT
   741	    `\n` count — robust against unterminated final line from crashed writer.
   742	    iter4-P1-2: malformed-header → quarantine active spool via direct
   743	    rename (NOT drain_now() — Phase 2 self-deadlocks on our flock) +
   744	    fresh-mint retry (bounded depth=1).
   745	    """
   746	    header = _SPOOL_HEADER_CACHE.get(pid)
   747	    spool_p = _spool_path(pid)
   748	
   749	    if header is not None and spool_p.exists():
   750	        return header
   751	
   752	    # iter2-P1-4: existing nonempty spool with no in-process header cache.
   753	    # Read the existing header instead of minting a colliding new one.
   754	    # iter5-P1: header reuse MUST apply the same strict 4-field validation
   755	    # that Phase 2 applies (_validate_spool_header_strict). Accepting a
   756	    # semantically incomplete header here lets new appends ride a file
   757	    # that Phase 2 will later quarantine → silent loss of the new events.
   758	    if spool_p.exists():
   759	        try:
   760	            st = spool_p.stat()
   761	        except OSError:
