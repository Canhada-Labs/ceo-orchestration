  9070	# PLAN-179 rail round-5 [P2] — rotating identity shards, best-effort sweep.
  9071	# A shard selects eligible names; it does not preserve directory position.
  9072	# Each sweep starts a fresh scandir and can hit its deadline before the
  9073	# same tail, so expired markers there have no guaranteed reclamation.
  9074	_GC_SHARDS = 8
  9075	
  9076	# Contador de VARREDURA (rail round-6 [P2]): o shard avanca por SWEEP, nunca
  9077	# pelo relogio — varreduras no mesmo minuto modulo K starvariam as outras.
  9078	_GC_SHARD_COUNTER_NAME = ".gc-shard-cursor"
  9079	
  9080	
  9081	def _gc_shard_of_name(name):
  9082	    """Shard estavel derivado do NOME (nunca da ordem de leitura)."""
  9083	    try:
  9084	        return zlib.crc32(name.encode("utf-8", "replace")) % _GC_SHARDS
  9085	    except Exception:
  9086	        return 0
  9087	
  9088	
  9089	def _gc_next_shard(state_dir):
  9090	    """Select the next shard from a best-effort persisted counter.
  9091	
  9092	    A successful read/write advances the counter. A failed read seeds it
  9093	    from randomness (zero if randomness also fails); a failed write can
  9094	    leave the same counter for the next sweep. This selects eligible names,
  9095	    without guaranteeing that the deadline-bounded scan reaches each name.
  9096	    The counter read and ancestor paths retain the rc.1 condition 28 limits;
  9097	    O_NOFOLLOW here protects only the temporary file used for the write.
  9098	    """
  9099	    counter_path = Path(str(state_dir)) / _GC_SHARD_COUNTER_NAME
  9100	    current = None
  9101	    try:
  9102	        raw = counter_path.read_text(encoding="utf-8").strip()
  9103	        current = int(raw)
  9104	    except Exception:
  9105	        current = None
  9106	    if current is None:
  9107	        try:
  9108	            current = int.from_bytes(os.urandom(2), "big")
  9109	        except Exception:
  9110	            current = 0
  9111	    nxt = (current + 1) % (_GC_SHARDS * 1024)  # espaco folgado, sem overflow
  9112	    try:
  9113	        counter_path.parent.mkdir(parents=True, exist_ok=True)
  9114	        tmp = counter_path.parent / (
  9115	            "." + counter_path.name + "." + str(os.getpid()) + "."
  9116	            + os.urandom(4).hex() + ".tmp"
  9117	        )
  9118	        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0)
  9119	        fd = os.open(str(tmp), flags, 0o600)
  9120	        try:
  9121	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
  9122	                fh.write(str(nxt))
  9123	        except Exception:
  9124	            try:
  9125	                os.unlink(str(tmp))
  9126	            except OSError:
  9127	                pass
  9128	            raise
  9129	        os.replace(str(tmp), str(counter_path))
  9130	    except Exception:
  9131	        pass  # housekeeping: nao persistir custa cobertura, nunca correcao
  9132	    return nxt % _GC_SHARDS
