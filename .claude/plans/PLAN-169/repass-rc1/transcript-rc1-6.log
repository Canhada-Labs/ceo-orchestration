  2046	
  2047	def _phase5_append_canonical(
  2048	    batch_lines: List[bytes], last_hmac: Optional[bytes]
  2049	) -> int:
  2050	    """Append batch to canonical log; single fsync; update sidecar cache.
  2051	
  2052	    iter2-P2-3: chain_length sidecar increment counts HMAC-bearing lines
  2053	    only — entries that failed HMAC compute (hmac=null + hmac_error set)
  2054	    don't extend the chain even though their bytes are appended. The
  2055	    sidecar is a cache for chain-verify performance; counting null-hmac
  2056	    lines would diverge from the true HMAC chain length.
  2057	    """
  2058	    if not batch_lines:
  2059	        return 0
  2060	    log_path = _canonical_log_path()
  2061	    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
  2062	
  2063	    # PLAN-094-FOLLOWUP Wave A.3-rotation — probe rotation BEFORE the
  2064	    # canonical append so spool-drained writes never accumulate past the
  2065	    # configured threshold. Lazy-import audit_emit (circular dep at
  2066	    # module load time) + audit_hmac for chain reset.
  2067	    try:
  2068	        from _lib import audit_emit as _audit_emit_lazy
  2069	        from _lib import audit_hmac as _audit_hmac_lazy
  2070	        # PLAN-143 item-2 (audit-errors-02): guard the rotation probe — a
  2071	        # capture-shim object may lack _rotate_if_needed_safe (see the
  2072	        # phase-4 probe above). getattr-guard -> missing attribute means
  2073	        # "no rotation" (None), no AttributeError into the fail-open path.
  2074	        _rotate_probe = getattr(
  2075	            _audit_emit_lazy, "_rotate_if_needed_safe", None
  2076	        )
  2077	        rotated_to = (
  2078	            _rotate_probe(log_path) if callable(_rotate_probe) else None
  2079	        )
  2080	        if rotated_to is not None and not _audit_hmac_lazy.is_disabled():
  2081	            try:
  2082	                _audit_hmac_lazy.reset_chain_on_rotation()
  2083	                # Reset last_hmac so this batch re-anchors at genesis.
  2084	                last_hmac = None
  2085	            except Exception as re:
  2086	                _breadcrumb(
  2087	                    f"phase5 rotation HMAC reset failed: "
  2088	                    f"{type(re).__name__}: {re}"
  2089	                )
  2090	    except Exception as e:
  2091	        # Fail-open: rotation probe never blocks the canonical append.
  2092	        _breadcrumb(f"phase5 rotation probe failed: {type(e).__name__}: {e}")
  2093	
  2094	    payload = b"".join(batch_lines)
  2095	    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
  2096	    try:
  2097	        os.write(fd, payload)
  2098	        os.fsync(fd)
  2099	    finally:
  2100	        os.close(fd)
  2101	
  2102	    if (_HMAC_AVAILABLE and _audit_hmac is not None
  2103	            and not _audit_hmac.is_disabled()
  2104	            and last_hmac is not None
  2105	            and len(last_hmac) == _audit_hmac.HMAC_BYTES):
  2106	        try:
  2107	            _audit_hmac.write_last_hmac(last_hmac)
  2108	        except Exception as e:
  2109	            _breadcrumb(f"write_last_hmac failed: {type(e).__name__}: {e}")
  2110	        # iter2-P2-3: count HMAC-bearing lines only.
  2111	        hmac_bearing = 0
  2112	        for line in batch_lines:
  2113	            try:
  2114	                obj = json.loads(line.rstrip(b"\n").decode("utf-8"))
  2115	            except (json.JSONDecodeError, UnicodeDecodeError):
  2116	                continue
  2117	            if not isinstance(obj, dict):
  2118	                continue
  2119	            hx = obj.get("hmac")
  2120	            if isinstance(hx, str) and len(hx) == 64:
  2121	                hmac_bearing += 1
  2122	        try:
  2123	            current = _audit_hmac.read_chain_length()
  2124	            _audit_hmac.write_chain_length(current + hmac_bearing)
  2125	        except Exception as e:
  2126	            _breadcrumb(f"chain_length update failed: {type(e).__name__}: {e}")
  2127	    return len(batch_lines)
