   687	def _forensic(action: str, fields: Dict[str, Any]) -> None:
   688	    """Emit a forensic audit event via wired callback; swallow errors.
   689	
   690	    P1-4: recursion guard — if we're already inside a _forensic() emit,
   691	    write a breadcrumb and return without re-entering spool_append.
   692	    """
   693	    global _IN_FORENSIC_EMIT
   694	    cb = _FORENSIC_EMIT
   695	    if cb is None:
   696	        return
   697	    if _IN_FORENSIC_EMIT:
   698	        _breadcrumb(f"forensic re-entry blocked: {action}")
   699	        return
   700	    _IN_FORENSIC_EMIT = True
   701	    try:
   702	        cb(action, fields)
   703	    except Exception as e:  # pragma: no cover
   704	        _breadcrumb(f"forensic emit failed: {action}: {type(e).__name__}: {e}")
   705	    finally:
   706	        _IN_FORENSIC_EMIT = False
