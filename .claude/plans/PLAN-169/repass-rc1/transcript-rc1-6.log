   242	    def write_project_file(self, relative: str, content: str) -> Path:
   243	        """Write a file under self.project_dir, creating parents as needed."""
   244	        target = self.project_dir / relative
   245	        target.parent.mkdir(parents=True, exist_ok=True)
   246	        target.write_text(content, encoding="utf-8")
   247	        return target
   248	
   249	    def write_audit_file(self, relative: str, content: str) -> Path:
   250	        """Write a file under self.audit_dir (the isolated audit dir)."""
   251	        target = self.audit_dir / relative
   252	        target.parent.mkdir(parents=True, exist_ok=True)
   253	        target.write_text(content, encoding="utf-8")
   254	        return target
   255	
