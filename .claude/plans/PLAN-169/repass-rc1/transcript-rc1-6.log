   288	def _check_perm_0600(p: Path) -> None:
   289	    """Raise AuditHmacError on unsafe permissions, ownership, or symlinks.
   290	
   291	    PLAN-045 Wave 1 F-01-06 hardening:
   292	
   293	    1. **Symlink reject.** A 0600 symlink pointing to an attacker file
   294	       passes a naive mode check; reject any symlink leaf outright.
   295	    2. **Ownership check.** ``st_uid == os.getuid()``. On a multi-user
   296	       host, a 0600 file owned by a different user (e.g. inherited via
   297	       ``chown`` after a hostile ``git stash pop``) previously passed
   298	       this check; now it fails.
   299	    3. **Group/world bits.** Retained from the existing check
   300	       (security-engineer review §2): ``mode & 0o077 != 0`` fails.
   301	
   302	    Parent-dir perms are validated at the caller in
   303	    :func:`get_or_create_key` via ``parent.mkdir(mode=0o700)``; a parent
   304	    created with different perms will be re-mkdir'd (mkdir is idempotent
   305	    only on existence, not perms — the mode arg has no effect once the
   306	    dir exists). The belt-and-suspenders parent-dir check is in
   307	    :func:`_check_parent_dir_owned_0700` for callers that want it.
   308	    """
   309	    try:
   310	        if p.is_symlink():
   311	            raise AuditHmacError(
   312	                "refusing to use symlinked audit-key at {p}".format(p=p)
   313	            )
   314	    except OSError as e:
   315	        raise AuditHmacError(
   316	            "is_symlink check failed on {p}: {e}".format(p=p, e=e)
   317	        ) from e
   318	    try:
   319	        st = p.stat()
   320	    except OSError as e:
   321	        raise AuditHmacError("stat failed on {p}: {e}".format(p=p, e=e)) from e
   322	    if st.st_uid != os.getuid():
   323	        raise AuditHmacError(
   324	            "audit-key ownership mismatch at {p}: owned by uid {u} "
   325	            "(expected {e})".format(p=p, u=st.st_uid, e=os.getuid())
   326	        )
   327	    if st.st_mode & 0o077 != 0:
   328	        raise AuditHmacError(
   329	            "unsafe perms on {p}: {m} "
   330	            "(must be owner-only 0600; group/world bits present)".format(
   331	                p=p, m=stat.filemode(st.st_mode)
   332	            )
   333	        )
   334	
   335	
   336	def _check_parent_dir_owned_0700(p: Path) -> None:
   337	    """PLAN-045 Wave 1 F-01-06: optional parent-dir hardening check.
   338	
   339	    Not called from :func:`_check_perm_0600` automatically because the
   340	    parent-dir is created via ``mkdir(mode=0o700)`` on key creation
   341	    path, and enforcing it on every :func:`read_prev_hmac` or
   342	    :func:`write_last_hmac` would be overly strict on hosts with
   343	    historically-created state dirs. Callers that want the strictest
   344	    invariant (e.g. :func:`verify_chain` in ``--strict`` mode) invoke
   345	    this explicitly.
   346	
   347	    Raises AuditHmacError on: parent missing / symlinked / not owned
   348	    by us / mode not 0700.
   349	    """
   350	    parent = p.parent
   351	    try:
   352	        if parent.is_symlink():
   353	            raise AuditHmacError(
   354	                "audit-key parent is a symlink: {p}".format(p=parent)
   355	            )
   356	        if not parent.is_dir():
   357	            raise AuditHmacError(
   358	                "audit-key parent is not a directory: {p}".format(p=parent)
   359	            )
   360	        st = parent.stat()
   361	    except OSError as e:
   362	        raise AuditHmacError(
   363	            "parent-dir stat failed on {p}: {e}".format(p=parent, e=e)
   364	        ) from e
   365	    if st.st_uid != os.getuid():
   366	        raise AuditHmacError(
   367	            "audit-key parent ownership mismatch at {p}: owned by uid {u}".format(
   368	                p=parent, u=st.st_uid
   369	            )
   370	        )
   371	    if (st.st_mode & 0o777) != 0o700:
   372	        raise AuditHmacError(
   373	            "audit-key parent perms on {p}: {m} "
   374	            "(must be 0700)".format(p=parent, m=stat.filemode(st.st_mode))
   375	        )
   376	
   377	
   378	def get_or_create_key() -> bytes:
   379	    """Return the 32-byte audit-key, generating it atomically if absent.
   380	
   381	    Process-level cache: first call reads or generates + validates perms
   382	    + caches; subsequent calls return the cached value.
   383	
   384	    :raises AuditHmacError: on filesystem error or perm violation.
   385	    """
   386	    global _KEY_CACHE
   387	    p = key_path()
   388	    # rail r6: identidade ABSOLUTA — um override relativo + chdir entre
   389	    # projetos manteria str(p) igual apontando para OUTRO arquivo.
   390	    p_id = os.path.abspath(str(p))
   391	    cached = _KEY_CACHE
   392	    if cached is not None and cached[0] == p_id:
   393	        return cached[1]
   394	
   395	    # rail r2 F + r5: cria e — SO no caminho DEFAULT (nenhum override de
   396	    # env escolheu o dir) — aperta para 0700. Um dir apontado por
   397	    # CEO_AUDIT_KEY_PATH / CEO_AUDIT_LOG_PATH / CEO_AUDIT_LOG_DIR /
   398	    # CEO_PROJECT_STATE_DIR pode ser 0750 DELIBERADO (compliance/vault);
   399	    # o primeiro load da chave nao pode revogar acesso de auditor.
   400	    _overridden = any(os.environ.get(_k) for _k in (
   401	        "CEO_AUDIT_KEY_PATH", "CEO_AUDIT_LOG_PATH",
   402	        "CEO_AUDIT_LOG_DIR", "CEO_PROJECT_STATE_DIR",
   403	        "CLAUDE_PROJECT_DIR_NATIVE"))  # rail r6: whole-dir override idem
   404	    _runtime_paths.ensure_state_dir(p.parent, tighten=not _overridden)
   405	
   406	    if not p.exists():
   407	        # Atomic create: write to tempfile with O_EXCL → rename.
   408	        # Race-safe against parallel audit_log invocations because we
   409	        # check existence after write and prefer the already-existing
   410	        # key.
   411	        tmp = p.with_name(p.name + ".tmp.{pid}".format(pid=os.getpid()))
   412	        try:
   413	            fd = os.open(
   414	                str(tmp),
   415	                os.O_WRONLY | os.O_CREAT | os.O_EXCL,
   416	                0o600,
   417	            )
   418	            try:
   419	                os.write(fd, secrets.token_bytes(KEY_BYTES))
   420	            finally:
   421	                os.close(fd)
   422	            if p.exists():
   423	                # Another process created the real key; discard ours.
   424	                try:
   425	                    os.unlink(tmp)
   426	                except OSError:
   427	                    pass
   428	            else:
   429	                os.replace(str(tmp), str(p))
   430	        except FileExistsError:
   431	            # tmp existed (stale). Remove + fall through to the read.
   432	            try:
   433	                if tmp.exists():
   434	                    os.unlink(tmp)
   435	            except OSError:
   436	                pass
   437	        except OSError as e:
   438	            try:
   439	                if tmp.exists():
   440	                    os.unlink(tmp)
   441	            except OSError:
   442	                pass
   443	            raise AuditHmacError(
   444	                "could not create {p}: {e}".format(p=p, e=e)
   445	            ) from e
   446	
   447	    _check_perm_0600(p)
   448	
   449	    try:
   450	        data = p.read_bytes()
   451	    except OSError as e:
   452	        raise AuditHmacError(
   453	            "could not read {p}: {e}".format(p=p, e=e)
   454	        ) from e
   455	
   456	    if len(data) != KEY_BYTES:
   457	        raise AuditHmacError(
   458	            "{p} is {n} bytes, expected {k}".format(
   459	                p=p, n=len(data), k=KEY_BYTES
   460	            )
   461	        )
   462	
   463	    _KEY_CACHE = (p_id, data)
   464	    return data
   465	
