   976	def spool_append(entry: Dict[str, Any]) -> None:
   977	    """Write entry to per-PID spool with 4-tuple metadata + fsync.
   978	
   979	    Stamps wall_ns, pid, spool_uuid, ordinal_within_file, record_id.
   980	    Wraps spool write in begin/commit journal envelopes for crash
   981	    forensics. Fail-open: any infra error writes a breadcrumb and
   982	    returns silently.
   983	
   984	    P1-1: acquires per-PID spool flock for the header-ensure + body
   985	    append window so same-PID concurrent emit and signal-triggered drain
   986	    don't race. Module-level _IN_SPOOL_APPEND latch lets signal handler
   987	    detect a writer in progress and bail.
   988	
   989	    P1-3: stamps `record_id` onto the spool entry so the drain Phase 5
   990	    `op:"drained"` envelope can carry it for session-start reconciliation.
   991	    """
   992	    global _IN_SPOOL_APPEND, _LAST_APPEND_SUCCEEDED
   993	    _LAST_APPEND_SUCCEEDED = False
   994	    try:
   995	        pid = os.getpid()
   996	        record_id = uuid.uuid4().hex
   997	        spool_p = _spool_path(pid)
   998	        # Per-PID spool flock — ADR-055-AMEND-1 §4 Phase 1: writers acquire
   999	        # only their own spool's flock + journal's flock (never canonical).
  1000	        try:
  1001	            spool_flock = FileLock(
  1002	                _spool_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT,
  1003	            )
  1004	        except OSError as e:
  1005	            _breadcrumb(f"spool flock alloc failed: {type(e).__name__}: {e}")
  1006	            return
  1007	        try:
  1008	            with spool_flock:
  1009	                _IN_SPOOL_APPEND = True
  1010	                try:
  1011	                    header = _ensure_spool_header(pid)
  1012	                    # iter3-P1-1: isolate any unterminated final line from a
  1013	                    # prior crashed writer BEFORE we mint our ordinal so the
  1014	                    # new entry can't be silently lost via concatenation.
  1015	                    _ensure_spool_ready_for_append(pid)
  1016	                    spool_uuid = header["_spool_uuid"]
  1017	                    ordinal = _next_ordinal(pid)
  1018	
  1019	                    stamped: Dict[str, Any] = dict(entry)
  1020	                    stamped.setdefault("wall_ns", time.time_ns())
  1021	                    stamped["pid"] = pid
  1022	                    stamped["spool_uuid"] = spool_uuid
  1023	                    stamped["ordinal_within_file"] = ordinal
  1024	                    # P1-3: carry record_id through the spool so Phase 5
  1025	                    # can emit op:"drained" with matching id.
  1026	                    stamped["record_id"] = record_id
  1027	
  1028	                    try:
  1029	                        line_bytes = json.dumps(
  1030	                            stamped, separators=(",", ":"),
  1031	                            ensure_ascii=False,
  1032	                        ).encode("utf-8") + b"\n"
  1033	                    except (TypeError, ValueError) as e:
  1034	                        _breadcrumb(
  1035	                            f"spool encode failed: {type(e).__name__}: {e}"
  1036	                        )
  1037	                        return
  1038	
  1039	                    sha = hashlib.sha256(line_bytes).hexdigest()
  1040	
  1041	                    _write_journal_envelope(
  1042	                        pid, record_id, spool_uuid, ordinal, sha, "begin",
  1043	                    )
  1044	
  1045	                    try:
  1046	                        fd = os.open(
  1047	                            str(spool_p),
  1048	                            os.O_WRONLY | os.O_CREAT | os.O_APPEND,
  1049	                            0o600,
  1050	                        )
  1051	                        try:
  1052	                            os.write(fd, line_bytes)
  1053	                            os.fsync(fd)
  1054	                        finally:
  1055	                            os.close(fd)
  1056	                    except OSError as e:
  1057	                        _breadcrumb(
  1058	                            f"spool append failed: {type(e).__name__}: {e}"
  1059	                        )
  1060	                        return
  1061	
  1062	                    _write_journal_envelope(
  1063	                        pid, record_id, spool_uuid, ordinal, sha, "commit",
  1064	                    )
  1065	                    _LAST_APPEND_SUCCEEDED = True
  1066	                finally:
  1067	                    _IN_SPOOL_APPEND = False
  1068	        except FileLockTimeout:
  1069	            _IN_SPOOL_APPEND = False
  1070	            _breadcrumb(f"spool flock timeout pid={pid}")
  1071	            return
  1072	    except Exception as e:  # fail-open invariant
  1073	        _IN_SPOOL_APPEND = False
  1074	        _breadcrumb(f"spool_append unexpected: {type(e).__name__}: {e}")
