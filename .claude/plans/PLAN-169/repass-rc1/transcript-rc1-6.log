  2309	def _own_spool_stale_past_trigger(pid: int) -> bool:
  2310	    """True iff our own spool's mtime age exceeds DRAIN_TRIGGER_MTIME_MS.
  2311	
  2312	    (ADR-055-AMEND-3) SEC veto-floor MF-1 gate. When an opportunistic
  2313	    (force=False) drain yields the canonical lock AND our own spool is already
  2314	    stale past the staleness trigger, the lock holder is not keeping up — that
  2315	    is genuine drain starvation (a wedged/contended holder), distinct from
  2316	    benign single-winner contention (a fresh spool). OSError-safe: a missing or
  2317	    unreadable spool returns False (fail-quiet, never raises).
  2318	    """
  2319	    try:
  2320	        st = _spool_path(pid).stat()
  2321	    except OSError:
  2322	        return False
  2323	    if st.st_size == 0:
  2324	        return False
  2325	    age_ms = (time.time() - st.st_mtime) * 1000.0
  2326	    return age_ms > DRAIN_TRIGGER_MTIME_MS
