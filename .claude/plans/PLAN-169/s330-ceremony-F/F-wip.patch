+                    proc = _run(["--check", "--spec", str(spec_path)], root)
+                    self.assertEqual(proc.returncode, 2, proc.stderr)
+                    self.assertIn("INFRA", proc.stderr)
+
+    def test_a_missing_input_exits_infra(self) -> None:
