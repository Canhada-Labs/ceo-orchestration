+
+    def test_a_partly_emptied_block_keeps_its_survivors(self) -> None:
+        base = {
+            "hooks": {"PreToolUse": [_group(
+                "Edit",
+                _hook("python3 .claude/hooks/gone.py"),
+                _hook("python3 .claude/hooks/keep.py"),
