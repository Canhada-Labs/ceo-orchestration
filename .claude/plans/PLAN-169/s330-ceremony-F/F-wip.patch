+# ---------------------------------------------------------------------------
+# the plugin ACCEL overlap — DECLARED DEBT with anti-rot
+# ---------------------------------------------------------------------------
+
+class PluginAccelOverlapIsDeclaredDebt(TestEnvContext):
+    """``build-plugin.py`` re-adds four hooks the user template now registers.
+
+    ``scripts/build-plugin.py`` builds the plugin's ``hooks.json`` from the
+    user template's ``.hooks`` (``:284``) and then EXTENDS it with its own
+    ``ACCEL`` table (``:44-66``). Before wave-F those four hooks were absent
+    from the template, so ACCEL was the only source. Now the template
+    registers them, so the plugin build emits each one TWICE — and with
+    divergent timeouts (``review_loop.py`` 60 vs the template's 15,
+    ``turbo_sessionstart.py`` 10 vs 5).
+
+    ``scripts/build-plugin.py`` is outside this wave's FILE ASSIGNMENT, so the
+    reconciliation is a follow-up (DESIGN-F §5, FU-F-ACCEL). What lands here
+    is the tripwire: the overlap is asserted to be EXACTLY the known set, so
+    the ceremony that reconciles ACCEL — or anything that widens the overlap —
+    turns this red with a message saying what to do. Green-now, red-on-change,
+    in BOTH directions; never a silent pass.
+
+    Doctrine: [[feedback-widen-guard-then-declare-debt]] — when the cure is
+    blocked, declare the debt per path with anti-rot rather than leave the
+    guard falsely green or land a knowingly-red test.
+    """
+
+    BUILD_PLUGIN = REPO_ROOT / "scripts" / "build-plugin.py"
+
+    #: Measured S330 against build-plugin.py ACCEL. Shrinks to empty when the
+    #: follow-up reconciles ACCEL; then this test asserts emptiness instead.
+    KNOWN_OVERLAP = {
+        "accel_dispatch.py",
+        "codex_review_user_code.py",
+        "review_loop.py",
+        "turbo_sessionstart.py",
+    }
+
+    def _accel_hook_names(self) -> set:
+        """Names ACCEL registers, read from the file. Never imported.
+
+        Importing build-plugin.py would execute module-level code that writes
+        into dist/; the AST is the safe reader.
+        """
+        tree = ast.parse(self.BUILD_PLUGIN.read_text(encoding="utf-8"))
+        accel = None
+        for node in tree.body:
+            if isinstance(node, ast.Assign):
+                for target in node.targets:
+                    if isinstance(target, ast.Name) and target.id == "ACCEL":
+                        accel = node.value
+        self.assertIsNotNone(
+            accel,
+            "no module-level ACCEL assignment in %s — this tripwire has lost "
+            "its subject; re-point it or delete it deliberately" % self.BUILD_PLUGIN,
+        )
+        names = set()
+        for literal in ast.walk(accel):
+            if isinstance(literal, ast.Constant) and isinstance(literal.value, str):
+                for found in re.findall(r"([A-Za-z0-9_.\-]+\.py)", literal.value):
+                    names.add(found.rsplit("/", 1)[-1])
+        return names
+
+    def test_the_overlap_is_exactly_the_known_debt(self) -> None:
+        if not self.BUILD_PLUGIN.is_file():
+            self.skipTest("scripts/build-plugin.py absent")
+        template_names = set(n for _, n in _registrations(_read(USER_TEMPLATE)))
+        overlap = template_names & self._accel_hook_names()
+        self.assertEqual(
+            overlap, self.KNOWN_OVERLAP,
+            "the user template / build-plugin ACCEL overlap CHANGED.\n"
+            "  expected (declared debt, DESIGN-F FU-F-ACCEL): %s\n"
+            "  found:                                          %s\n"
+            "Every name in the overlap is registered TWICE in the plugin's "
+            "hooks.json (build-plugin.py:284 reads the template, :44-66 "
+            "appends ACCEL). If you reconciled ACCEL, shrink KNOWN_OVERLAP to "
+            "match (empty is the goal). If you added a hook to the template "
+            "that ACCEL also carries, reconcile ACCEL in the SAME patch."
+            % (sorted(self.KNOWN_OVERLAP), sorted(overlap)),
+        )
+
+    def test_the_debt_is_recorded_in_the_design(self) -> None:
+        """A tripwire nobody documented is a tripwire nobody will act on."""
+        design = REPO_ROOT / ".claude" / "plans" / "PLAN-169" / "s330-ceremony-F" / "DESIGN-F.md"
+        if not design.is_file():
+            self.skipTest("DESIGN-F.md not present in this tree")
+        text = design.read_text(encoding="utf-8")
+        # assertTrue, not assertIn: a failing assertIn would dump the whole
+        # design document into the report.
+        self.assertTrue(
+            "FU-F-ACCEL" in text,
+            "DESIGN-F.md does not carry the FU-F-ACCEL follow-up id",
+        )
+        missing = [n for n in sorted(self.KNOWN_OVERLAP) if n not in text]
+        self.assertEqual(
+            missing, [],
+            "these names are in the declared ACCEL overlap but the DESIGN "
+            "does not name them: %s" % missing,
+        )
+
+
+# ---------------------------------------------------------------------------
+# (h) the generator itself
+# ---------------------------------------------------------------------------
+
+class GeneratorRuntimeContract(TestEnvContext):
+    """stdlib-only and Python 3.9 — the repo's floor (CLAUDE.md §4)."""
+
+    STDLIB = {
+        "__future__", "argparse", "difflib", "hashlib", "json", "re",
+        "subprocess", "sys", "pathlib", "typing",
+    }
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.tree = ast.parse(GENERATOR.read_text(encoding="utf-8"))
+
+    def test_compiles(self) -> None:
+        py_compile.compile(str(GENERATOR), doraise=True)
+
+    def test_imports_are_stdlib_only(self) -> None:
+        imported = set()
+        for node in ast.walk(self.tree):
+            if isinstance(node, ast.Import):
+                imported.update(a.name.split(".")[0] for a in node.names)
+            elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+                imported.add(node.module.split(".")[0])
+        extra = imported - self.STDLIB
+        self.assertEqual(extra, set(), "non-stdlib import(s): %s" % sorted(extra))
+
+    def test_uses_postponed_annotations(self) -> None:
+        futures = [
+            a.name
+            for node in self.tree.body
+            if isinstance(node, ast.ImportFrom) and node.module == "__future__"
+            for a in node.names
+        ]
+        self.assertIn("annotations", futures)
+
+    def test_no_match_statement(self) -> None:
+        match_node = getattr(ast, "Match", None)
+        if match_node is None:
+            self.skipTest("running on Python 3.9; a match statement would not parse")
+        self.assertFalse(
+            [n for n in ast.walk(self.tree) if isinstance(n, match_node)],
+            "match statements are Python >= 3.10; the floor is 3.9",
+        )
+
+    def test_no_runtime_pep604_union(self) -> None:
+        """`X | Y` is fine in an annotation (postponed) but not at runtime."""
+        offenders = []
+        for node in ast.walk(self.tree):
+            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.BitOr):
+                offenders.append(getattr(node, "lineno", "?"))
+        self.assertEqual(offenders, [], "runtime `|` union at line(s) %s" % offenders)
+
+
+if __name__ == "__main__":  # pragma: no cover
+    unittest.main()
