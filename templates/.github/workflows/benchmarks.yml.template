name: Skill benchmarks (advisory)

# INERT AS SHIPPED. install.sh copies this file to
# `.github/workflows/benchmarks.yml.template` — the `.template` suffix means
# GitHub Actions never reads it. Activation is an EXPLICIT adopter step
# (plain `mv -n`, not `git mv`: on a fresh install the delivered file is
# UNTRACKED so `git mv` fails — measured S344, PLAN-183 AC-2 — and `-n`
# refuses to clobber a benchmarks.yml of your own — but on that collision
# `mv -n` exits 0 WITHOUT moving, so the workflow stays INERT: check the
# rename landed, or pick another name, before you commit):
#   mv -n .github/workflows/benchmarks.yml.template \
#         .github/workflows/benchmarks.yml
#
# ONCE ACTIVATED THIS COSTS REAL MONEY ON YOUR OWN ACCOUNT. It requires the
# repository secret ANTHROPIC_API_KEY (Settings -> Secrets and variables ->
# Actions). Each run bills YOUR Anthropic account: one API call per benchmark
# scenario per repetition, for every benchmark YAML under
# `.claude/skills/**/benchmarks/`. There is no framework-side spend cap — the
# only throttle is the paths filter below. With no secret configured the job
# skips visibly and bills nothing.
#
# SELF-CONTAINED BY CONTRACT (PLAN-183 W2 / finding A3): every script this
# workflow calls must be one the installer actually delivers.
# `.claude/scripts/run-skill-benchmark.py` ships via
# install.sh::install_scripts_selective(). The framework's own
# `.github/scripts/` is NOT installed, so nothing here may reference it.
#
# Only runs on changes to skill benchmarks, the runner, or this workflow
# itself. Per PLAN-002 §11-bis Q2: paths filter keeps docs/plans/hooks PRs
# from paying API cost.
on:
  pull_request:
    paths:
      - ".claude/skills/**/benchmarks/**"
      - ".claude/scripts/run-skill-benchmark.py"
      - ".github/workflows/benchmarks.yml"
  push:
    branches: [main]
    paths:
      - ".claude/skills/**/benchmarks/**"
      - ".claude/scripts/run-skill-benchmark.py"
      - ".github/workflows/benchmarks.yml"

concurrency:
  group: benchmarks-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  # Write permission needed for $GITHUB_STEP_SUMMARY
  pull-requests: write

jobs:
  benchmarks:
    name: Run skill benchmarks
    runs-on: ubuntu-latest
    timeout-minutes: 10

    # Fork PR safety: benchmarks require ANTHROPIC_API_KEY which fork PRs
    # don't have access to. Skip visibly on forks. pull_request_target is
    # EXPLICITLY FORBIDDEN per PLAN-002 §8 finding #18 (code-injection
    # vector in the forked repo's workflow).
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          set -euo pipefail
          python3 -m pip install --upgrade pip
          python3 -m pip install pyyaml anthropic

      - name: Detect changed benchmarks
        id: detect
        run: |
          set -euo pipefail
          # Find all benchmark YAMLs under skills/
          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml' 2>/dev/null)
          if [ ${#ALL_BENCHES[@]} -eq 0 ]; then
            echo "no_benchmarks=true" >> "$GITHUB_OUTPUT"
            echo "No benchmark YAMLs found — nothing to run" >&2
          else
            printf 'found %d benchmark file(s):\n' "${#ALL_BENCHES[@]}"
            printf '  %s\n' "${ALL_BENCHES[@]}"
          fi

      - name: Run benchmarks (advisory, skip-if-no-key)
        id: bench
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          set -euo pipefail
          mkdir -p benchmark-results

          if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
            echo "SKIPPED: ANTHROPIC_API_KEY secret not set (advisory mode)." >&2
            echo "skipped=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          FAILED=0
          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml')
          # Sprint 3 Item B: absolute floor at 0.6 + write lessons on failure.
          # Per debate consensus R-DEV1, rc=1 for ALL floor failures (no new
          # exit codes — we distinguish via $GITHUB_STEP_SUMMARY, not rc).
          for bench in "${ALL_BENCHES[@]}"; do
            base=$(basename "$bench" .yaml)
            echo "::group::Running $bench"
            out="benchmark-results/${base}.json"
            md="benchmark-results/${base}.md"
            if ! python3 .claude/scripts/run-skill-benchmark.py \
                 "$bench" \
                 --output-json "$out" \
                 --markdown \
                 --floor 0.6 \
                 --write-lessons \
                 --skip-if-no-key > "$md"; then
              rc=$?
              if [ "$rc" -eq 1 ]; then
                echo "::error::$bench below floor (CRITICAL or <0.6)"
                FAILED=1
              else
                echo "::error::$bench: runner error rc=$rc"
                FAILED=1
              fi
            fi
            if [ -s "$md" ]; then cat "$md"; fi
            echo "::endgroup::"
          done

          echo "failed=$FAILED" >> "$GITHUB_OUTPUT"

      - name: Post results to $GITHUB_STEP_SUMMARY
        if: always()
        run: |
          set -euo pipefail
          if [ "${{ steps.bench.outputs.skipped }}" = "true" ]; then
            {
              printf '## Benchmarks skipped\n\n'
              printf 'ANTHROPIC_API_KEY secret is not configured.\n'
              printf 'Enable in Settings -> Secrets and variables -> Actions.\n'
            } >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          if [ ! -d benchmark-results ] || [ -z "$(ls -A benchmark-results 2>/dev/null)" ]; then
            printf '## Benchmarks: no results produced\n' >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          # PLAN-183 W2 / A3: the summary is built from the per-benchmark
          # Markdown that .claude/scripts/run-skill-benchmark.py emits with
          # --markdown (captured per bench in the step above). The framework's
          # .github/scripts/ is NOT installed, so it must not be called here.
          if ls benchmark-results/*.md >/dev/null 2>&1; then
            cat benchmark-results/*.md >> "$GITHUB_STEP_SUMMARY"
          else
            printf '## Benchmarks: results produced but no Markdown captured\n' \
              >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Upload benchmark JSON results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: benchmark-results
          path: benchmark-results/
          if-no-files-found: ignore
          retention-days: 30

      - name: Fail on floor breach
        if: steps.bench.outputs.failed == '1'
        run: |
          echo "::error::One or more benchmarks fell below floor (CRITICAL < 0.4 or absolute < 0.6)"
          exit 1
